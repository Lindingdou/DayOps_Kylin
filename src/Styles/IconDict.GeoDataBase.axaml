    <!-- ───── 工艺参数管理 ───── -->

    <!-- 爆破参数：圆爆点 + 放射线 + 调节齿轮影 -->
    <DrawingImage x:Key="param_blast">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 放射线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFEF4444" Thickness="1.2" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,4 L16,9 M28,16 L23,16 M16,28 L16,23 M4,16 L9,16 M24.5,7.5 L20.5,11.5 M24.5,24.5 L20.5,20.5 M7.5,24.5 L11.5,20.5 M7.5,7.5 L11.5,11.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中心爆点 -->
                <GeometryDrawing Brush="#FFFBBF24">
                    <GeometryDrawing.Pen><Pen Brush="#FFB45309" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="6" RadiusY="6" Center="16,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中心高光 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="2" RadiusY="2" Center="14,14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

