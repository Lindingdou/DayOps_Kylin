    <!-- =================================================================
         Needs.md 19 项功能图标（其中 3 项复用 geo_db / geo_strata / param_drill）
         立体派 / 32×32 viewBox / 渐变 + 描边 + 多层
         ================================================================= -->

    <!-- ─────────── 钻孔管理 (5 个新) ─────────── -->

    <!-- 导入钻孔数据：蓝色钻孔筒 + 绿色下箭头 -->
    <DrawingImage x:Key="bh_import">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 钻孔筒（俯视椭圆 + 圆柱身） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF93C5FD" Offset="0"/>
                            <GradientStop Color="#FF1E40AF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,17 L10,28 C10,29.5 13,30 16,30 C19,30 22,29.5 22,28 L22,17 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFBFDBFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="6" RadiusY="2" Center="16,17"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿色下箭头（导入动作） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF34D399" Offset="0"/>
                            <GradientStop Color="#FF059669" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M14,2 L18,2 L18,9 L22,9 L16,15 L10,9 L14,9 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 展绘钻孔：地图俯视 + 红色定位标记 + 同心圆波纹 -->
    <DrawingImage x:Key="bh_plot">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 地图底（浅蓝） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFE0F2FE" Offset="0"/>
                            <GradientStop Color="#FFBFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="1" RadiusY="1" Rect="3,5,26,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 等高线（淡） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF93C5FD" Thickness="0.5">
                            <Pen.DashStyle><DashStyle Dashes="1,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,11 L27,11 M5,17 L27,17 M5,23 L27,23 M10,5 L10,27 M22,5 L22,27"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 红色定位水滴 -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFEF4444" Offset="0"/>
                            <GradientStop Color="#FFB91C1C" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF7F1D1D" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,8 C20,8 22,11 22,14 C22,18 16,24 16,24 C16,24 10,18 10,14 C10,11 12,8 16,8 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 标记中心白圆 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="2.4" RadiusY="2.4" Center="16,14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF7F1D1D">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1" RadiusY="1" Center="16,14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 虚拟钻孔：紫色虚线钻孔轮廓 + 中心 V 字（virtual） -->
    <DrawingImage x:Key="bh_virtual">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 虚拟外轮廓（紫色虚线） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFA78BFA" Opacity="0.18"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF7C3AED" Thickness="1.4" LineJoin="Round">
                            <Pen.DashStyle><DashStyle Dashes="2,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,3 L10,27 C10,28.5 13,29 16,29 C19,29 22,28.5 22,27 L22,3 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部椭圆口（虚线） -->
                <GeometryDrawing Brush="{x:Null}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF7C3AED" Thickness="1">
                            <Pen.DashStyle><DashStyle Dashes="2,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="6" RadiusY="2" Center="16,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中间紫色 V 字（virtual 标识） -->
                <GeometryDrawing Brush="#FF7C3AED">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,12 L13.5,12 L16,18 L18.5,12 L20,12 L16.8,21 L15.2,21 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

