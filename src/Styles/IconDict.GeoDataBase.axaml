            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ───── 基础地质信息管理 ───── -->

    <!-- 地层管理：三层堆叠（土黄/灰/深蓝），右上角小铲 -->
