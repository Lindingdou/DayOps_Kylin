    <!-- ─────────── 钻孔管理 · 补齐专属图标（替换之前的 param_drill / geo_db / geo_strata 复用） ─────────── -->

    <!-- 钻孔柱状图（化验孔 3D 排列）：三根前后错位的孔柱 + 化验段按 Ad 分色 -->
    <!--   与 bh_histogram（单孔 2D 岩芯）区分：那个是一根、看岩性；这个是一组、看化验值 -->
    <DrawingImage x:Key="bh_column_3d">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 后排孔（最矮最淡，制造纵深） -->
                <GeometryDrawing Brush="#FFE7E5E4">
                    <GeometryDrawing.Pen><Pen Brush="#FF57534E" Thickness="0.7" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="20,9,6,15"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="20,14,6,3"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 后排孔的化验段：Ad 高（红） -->
                <GeometryDrawing Brush="#FFDC2626">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="20,17,6,3"/></GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 中排孔 -->
                <GeometryDrawing Brush="#FFF5F5F4">
                    <GeometryDrawing.Pen><Pen Brush="#FF44403C" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="12,5,7,21"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="12,12,7,4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中排孔的化验段：Ad 中（橙） -->
                <GeometryDrawing Brush="#FFF59E0B">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="12,16,7,4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 前排孔（最高最实） -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.9" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="4,8,7,21"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="4,15,7,4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 前排孔的化验段：Ad 低（绿） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="4,19,7,4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 孔口（椭圆盖，点明是"孔"不是"条形图"） -->
                <GeometryDrawing Brush="#FFCBD5E1">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="3.5" RadiusY="1.3" Center="7.5,8"/>
                            <EllipseGeometry RadiusX="3.5" RadiusY="1.3" Center="15.5,5"/>
