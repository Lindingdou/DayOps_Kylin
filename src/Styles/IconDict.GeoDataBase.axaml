    <!-- ─────────── 设备管理 · 叙事修正专属图标 (32×32) ─────────── -->

    <!-- 班次效能预测：预测曲线(实线历史 + 虚线预测) + 底部早中夜三色班次带
         在 equip_forecast 基础上加班次粒度指示 -->
    <DrawingImage x:Key="equip_forecast_shift">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 坐标轴 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,24 L30,24 M4,3 L4,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 历史实线（蓝） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF3B82F6" Thickness="1.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,19 L9,17 L13,15 L16,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 预测虚线（紫） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF8B5CF6" Thickness="1.8" LineJoin="Round">
                            <Pen.DashStyle><DashStyle Dashes="2,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,12 L20,9 L24,6 L28,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 历史数据点 -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="9,17"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="13,15"/>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="16,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 预测终点（紫色大点） -->
                <GeometryDrawing Brush="#FF8B5CF6">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="28,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 底部早中夜三色班次带（黄=早 / 蓝=中 / 深蓝=夜） -->
                <GeometryDrawing Brush="#FFFBBF24">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="4,27,8,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF60A5FA">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="12.5,27,8,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1E3A8A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="21,27,8,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 数据导入导出：托盘 + 绿色下箭头(导入) + 橙色上箭头(导出) -->
    <DrawingImage x:Key="equip_import">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 底部托盘(开口盒) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="1.8" LineJoin="Round" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6,19 L6,26 L26,26 L26,19"/>
