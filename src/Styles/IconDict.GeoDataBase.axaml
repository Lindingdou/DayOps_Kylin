                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 放大镜（审视，叠加右下） -->
                <GeometryDrawing Brush="{x:Null}">
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="1.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="5" RadiusY="5" Center="21,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#66BFDBFE">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="4.2" RadiusY="4.2" Center="21,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 放大镜手柄 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="2" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M24.7,23.7 L29,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 空间分布：XYZ 坐标轴 + 彩色采样散点 + IDW 插值色片(等值)
         区别于 coal_dashboard 的 KPI 看板；story = 3D 空间分布 + 插值 -->
    <DrawingImage x:Key="coal_spatial">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- IDW 插值色片（底面，红黄绿渐变菱形） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#FF34D399" Offset="0"/>
                            <GradientStop Color="#FFFBBF24" Offset="0.55"/>
                            <GradientStop Color="#FFEF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="0.6" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6,24 L16,19 L28,25 L18,30 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 等值线（插值等值，淡白） -->
                <GeometryDrawing Brush="{x:Null}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFFFF" Thickness="0.5">
                            <Pen.DashStyle><DashStyle Dashes="1.5,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,25 L17,22 L24,25 M13,27 L17,25 L21,27"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- XYZ 坐标轴 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="0.9" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,21 L5,3 M5,21 L27,21 M5,21 L13,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 坐标轴箭头 -->
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M5,3 L3.5,6 L6.5,6 Z"/>
                            <PathGeometry Figures="M27,21 L24,19.5 L24,22.5 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 彩色采样散点（悬浮于空间，蓝/绿/橙/红/紫） -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="11,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="20,7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFB923C">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="24,13"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFEF4444">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="14,15"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF8B5CF6">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="22,17"/>
