<!-- 由 build/convert_icons.py 从原版自动 1:1 转换，勿手改 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      GeoDataBase 模块专属图标字典。
      由 GeoDataBasePlugin.Initialize() 通过 IResourceRegistry.MergeResourceDictionary
      合并进 Application.Resources，让 Ribbon 注册的 iconKey 能解析到这里的资源。
      新增 GeoDataBase 自己的图标时只改这一个文件；与 Host 全局 IconDict 解耦。
    -->

    <!-- 地质数据库图标（蓝色三段圆盘数据库筒）
         viewBox 0 0 1024 1024
         配色：底色 #0251BF（矿蓝），顶盘 #64A5FF（浅蓝），盘面缝隙 #FFFFFF -->
    <DrawingImage x:Key="geo_db">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 底段圆筒身（深蓝） -->
                <GeometryDrawing Brush="#FF0251BF" Geometry="F1 M57.457778,622.193778 L57.457778,827.619556 C59.164445,935.708445 236.600889,1022.691556 511.999999,1022.691556 C787.399109,1022.691556 964.664888,935.480889 966.541999,827.619556 L966.541999,622.193778 Z"/>
                <!-- 中下盘面顶（白边） -->
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M966.542222,621.397333 C966.542222,735.800889 788.423111,828.529778 511.999999,828.529778 C235.576889,828.529778 57.457778,735.800889 57.457778,621.397333 C57.457778,506.993777 235.576889,414.264889 511.999999,414.264889 C788.423111,414.264889 966.542222,506.880444 966.542222,621.397333 Z"/>
                <!-- 中段圆筒身（深蓝） -->
                <GeometryDrawing Brush="#FF0251BF" Geometry="F1 M57.457778,415.288889 L57.457778,597.333333 C59.164445,705.422222 236.600889,803.896889 511.999999,803.896889 C787.399109,803.896889 964.664888,705.137333 966.541999,597.333333 L966.541999,415.288889 Z"/>
                <!-- 中段盘面顶（白边） -->
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M966.542222,414.264889 C966.542222,528.668444 788.423111,621.397333 511.999999,621.397333 C235.576889,621.397333 57.457778,528.668444 57.457778,414.264889 C57.457778,299.861333 235.576889,207.132444 511.999999,207.132444 C788.423111,207.132444 966.542222,299.747999 966.542222,414.264889 Z"/>
                <!-- 上段圆筒身（深蓝） -->
                <GeometryDrawing Brush="#FF0251BF" Geometry="F1 M57.457778,207.928889 L57.457778,390.314667 C59.164445,498.403555 236.600889,596.878222 511.999999,596.878222 C787.399109,596.878222 964.664888,498.119111 966.541999,390.314667 L966.541999,207.928889 Z"/>
                <!-- 顶盘（亮蓝色帽） -->
