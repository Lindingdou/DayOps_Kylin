                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M9,15 L9.5,13.5 L10.5,14.5 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 填充比例：两组疏密不同的斜线 + 中间的间距箭头（对标 HPSCALE） -->
    <!-- 与 icon_hatch/icon_hatch_edit 同一配色（蓝框 #FF1E40AF + 橙线 #FFD97706），
         注释组三行参数才是一家人；原先借「测量」组的尺子/量角器，语义不对。 -->
    <DrawingImage x:Key="icon_hatch_scale">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 左半：密排斜线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFD97706" Thickness="0.9" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M1,4 L4,1 M1,7 L7,1 M1,10 L7,4 M1,13 L7,7 M3,13 L7,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 右半：疏排斜线（同角度，间距翻倍 → 一眼看出是"比例"） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFD97706" Thickness="0.9" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M9,7 L15,1 M9,13 L15,7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中缝：蓝色分界 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M8,1 L8,15"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 填充角度：方框内一束斜线 + 底边起算的角度弧（对标 HPANG） -->
    <DrawingImage x:Key="icon_hatch_angle">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 底边基准线（蓝） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1.1" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M1.5,14 L14.5,14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
