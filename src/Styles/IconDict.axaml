    <DrawingImage x:Key="icon_quick_select">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 外围虚线选择框：与 icon_select_all 同一套语汇（绿色虚线 = 选择集） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF10B981" Thickness="1.2">
                            <Pen.DashStyle><DashStyle Dashes="1.5,1"/></Pen.DashStyle>
