                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M13.8,12.5 L11.4,12.5 M12.4,11.5 L11.3,12.5 L12.4,13.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

