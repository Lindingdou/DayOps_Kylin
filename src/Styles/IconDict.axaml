                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿圆角标 + 白色左向箭头 = 取回 -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="2.4" RadiusY="2.4" Center="12.5,12.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
