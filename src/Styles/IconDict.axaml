                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12.5,18 L20.5,18 M12.5,21 L17,21"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 另存为：白色软盘 + 深描边 + 紫色铅笔徽章（点缀=另存为动作色；以徽章区别于"保存"） -->
    <DrawingImage x:Key="icon_saveas">
        <DrawingImage.Drawing>
