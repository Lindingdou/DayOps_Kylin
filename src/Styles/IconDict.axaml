            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 角度测量：两条边 + 弧 + 角度小符号 -->
    <DrawingImage x:Key="icon_measure_angle">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 两条相交边 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="1.4" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,14 L14,14 M2,14 L11,3"/>
