    <!-- 注册：软件许可/激活——证书卡(白底深描边) + 公章圆徽(绿✓) + 序列号横线 + 钥匙(橙)。非用户账号注册 -->
    <DrawingImage x:Key="icon_register">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 证书卡片（白底深描边） -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="0.9" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="1" RadiusY="1" Rect="1.5,2,11,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 序列号横线（中灰） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="0.8" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3.2,4.3 L10.8,4.3 M3.2,6 L9,6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 公章圆徽（绿底白✓，许可已激活语义） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FF065F46" Thickness="0.5"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="2.4" RadiusY="2.4" Center="4.6,8.4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.9" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3.5,8.5 L4.3,9.4 L5.8,7.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 钥匙（橙色单一点缀色，license key 语义）：环 + 杆 + 齿 -->
                <GeometryDrawing Brush="#FFF59E0B">
                    <GeometryDrawing.Pen><Pen Brush="#FFB45309" Thickness="0.5"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="2" RadiusY="2" Center="11.5,11.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="0.8" RadiusY="0.8" Center="11.5,11.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFF59E0B" Thickness="1.3"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M13,10 L15.3,7.7 M14.5,8.5 L15.3,9.3 M13.7,9.3 L14.3,9.9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

