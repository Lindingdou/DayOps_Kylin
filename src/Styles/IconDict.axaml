    <!-- 图层特性管理器：三色填充叠层 + 绿色属性面板 + 列表线 -->
    <DrawingImage x:Key="icon_layer">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 底层（灰） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
