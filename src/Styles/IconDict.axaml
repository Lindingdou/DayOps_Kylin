                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M24,10 L27.5,5.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 拖拽光标（白底深描边箭头，位于拖尾末端） -->
