                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M9,14 A6,6 0 0 0 6.8,9.3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶点小圆 -->
                <GeometryDrawing Brush="#FFEF4444">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.1" RadiusY="1.1" Center="2,14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 面积测量：填充多边形 + 角点 -->
    <DrawingImage x:Key="icon_measure_area">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 面（浅蓝填充） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FF3B82F6" Opacity="0.35"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,3 L13,5 L12,13 L4,12 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 4 个角点 -->
                <GeometryDrawing Brush="#FFEF4444">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.3"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="3,3"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="13,5"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="12,13"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="4,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 体积测量：等轴立方体（蓝色 3 面） -->
    <DrawingImage x:Key="icon_measure_volume">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 顶面（亮） -->
                <GeometryDrawing Brush="#FF93C5FD">
