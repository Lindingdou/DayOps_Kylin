<!-- 由 build/convert_icons.py 从原版 Host/PitMineApp/Assets/IconDict.xaml 自动 1:1 转换，勿手改 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Host 全部图标合并为单一字典（与 Modules/*/Assets/IconDict.xaml 同形）。
      旧 7 子字典 + Shared/Layers 已删；以下 5 个文件的内容按顺序合入：
        QuickAccess / Modify / Tools / CadToolbar / App
      已剔除 15 个无引用的 key（grep 全仓库未发现 StaticResource 使用）。
    -->

    <!-- ───── from IconDict.QuickAccess.xaml ───── -->

    <!-- 新建：白纸 + 深描边 + 右下角绿色⊕徽章（浅底家族：白底/深描边/单一动作色点缀） -->
    <DrawingImage x:Key="icon_new">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 白纸主体（深描边） -->
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1M8,4 L19,4 L24,9 L24,28 L8,28 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- 折角 -->
                <GeometryDrawing Geometry="F1M19,4 L19,9 L24,9">
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="1.2" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- 内容线（中灰，弱于主描边） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="1" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M11,13 L20,13 M11,17 L18,17 M11,21 L15,21"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿色⊕徽章（点缀=新建动作色；白描边 + 白＋） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#FF34D399"/>
                            <GradientStop Offset="1" Color="#FF059669"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.2"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="6" RadiusY="6" Center="22.5,23"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.8" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M22.5,19.5 L22.5,26.5 M19,23 L26,23"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 打开：白色文件夹 + 深描边 + 橙色翻盖（点缀=打开动作色） -->
    <DrawingImage x:Key="icon_open">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 文件夹后片（白底深描边） -->
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1M4,8 C4,7.4 4.5,7 5,7 L12,7 L15,10 L27,10 C27.5,10 28,10.5 28,11 L28,24 L4,24 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- 翻起的橙色前盖（单一动作色点缀） -->
                <GeometryDrawing Geometry="F1M4,24 L8,14 L30,14 L26,24 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#FFFBBF24"/>
                            <GradientStop Offset="1" Color="#FFF59E0B"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FFB45309" Thickness="0.9" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 保存：白色软盘 + 深描边 + 蓝色标签块（点缀=保存动作色） -->
