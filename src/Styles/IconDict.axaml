    <!-- 调用选择集：虚线框（存下的集合）+ 内容行 + 绿圆回指角标（取回来）。
         布局刻意与 icon_create_selection 同构（框 + 框内元素 + 右下角绿圆角标），
         两个按钮挨着放时一眼能看出是一对：一个存进去、一个取回来。
         ⚠ 箭头必须指向框【内】—— 指向框外读作"导出"，是完全相反的意思。 -->
    <DrawingImage x:Key="icon_recall_selection">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF3B82F6" Thickness="1" LineJoin="Round">
                            <Pen.DashStyle><DashStyle Dashes="1.5,1"/></Pen.DashStyle>
