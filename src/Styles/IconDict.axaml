            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 快速测量：尺子 + 闪电（速度感） -->
    <DrawingImage x:Key="icon_measure_quick">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFBBF24">
                    <GeometryDrawing.Pen><Pen Brush="#FF92400E" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen>
