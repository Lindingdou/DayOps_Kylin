                        <PathGeometry Figures="M1.5,14 L11,2 M5.5,14 L15,2 M9.5,14 L14,8.3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 角度弧（绿，落在基准线与线束之间） -->
