                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,2,28,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 漏斗（浅蓝底 + 蓝描边）= 按条件过滤 -->
                <GeometryDrawing Brush="#FFDBEAFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF3B82F6" Thickness="1.3" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
