                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M6,11 L13,11 M11,9 L13,11 L11,13"/></GeometryDrawing.Geometry>
