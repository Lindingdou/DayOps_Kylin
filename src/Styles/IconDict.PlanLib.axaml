<!-- 由 build/convert_icons.py 从原版自动 1:1 转换，勿手改 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      PlanLib 模块专属图标字典。
      由 PlanLibPlugin.Initialize() 通过 IResourceRegistry.MergeResourceDictionary
      合并进 Application.Resources。
      当前 "plan" 复用 PointCloudLib 的点云造型作为占位，后续按业务画专属图标时
      只改这一个文件。
    -->

    <!-- 生产计划编制 Tab 图标：日历框 + teal 标题栏 + 多色甘特条 -->
    <DrawingImage x:Key="plan">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 文档/日历外框 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF14B8A6" Thickness="1" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,5 L28,5 L28,28 L4,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部标题栏（teal 渐变） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF14B8A6" Offset="0"/>
                            <GradientStop Color="#FF0F766E" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,5,24,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部小日历格 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="6,7,1.5,1.5"/>
                            <RectangleGeometry Rect="9,7,1.5,1.5"/>
                            <RectangleGeometry Rect="12,7,1.5,1.5"/>
                            <RectangleGeometry Rect="15,7,1.5,1.5"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 时间轴分隔虚线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFE5E7EB" Thickness="0.4"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M11,11 L11,27 M17,11 L17,27 M23,11 L23,27"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 甘特条 1（蓝） -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="6,13,12,2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 甘特条 2（橙） -->
                <GeometryDrawing Brush="#FFFBBF24">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="12,17,10,2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 甘特条 3（绿） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="9,21,14,2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 甘特条 4（粉） -->
                <GeometryDrawing Brush="#FFEC4899">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="15,24.5,8,2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ───── 境界优化（teal 主色，台阶坑剖面） ───── -->

    <!-- 境界圈定设置：台阶坑剖面 + 三条配置滑块 + 橙色旋钮 -->
    <DrawingImage x:Key="pit_opt_config">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 台阶坑剖面（底） -->
                <GeometryDrawing Brush="#FFCCFBF1">
                    <GeometryDrawing.Pen><Pen Brush="#FF0F766E" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,14 L9,14 L13,19 L19,19 L23,24 L30,24 L30,28 L2,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 三条配置滑块 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF0F766E" Thickness="1.4" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6,4 L26,4 M6,8 L26,8 M6,12 L26,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 滑块旋钮（橙） -->
                <GeometryDrawing Brush="#FFFB923C">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="13,4"/>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="20,8"/>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="10,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 计算·确定境界：台阶坑（梯形）+ 台阶线 + 绿色确定徽章 -->
    <DrawingImage x:Key="pit_opt_solve">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 台阶坑（梯形渐变） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF5EEAD4" Offset="0"/>
                            <GradientStop Color="#FF0F766E" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF134E4A" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,6 L29,6 L22,25 L10,25 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 台阶线（坡顶/坡底） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M7,12 L25,12 M9,18 L23,18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿色"确定"徽章 -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="5" RadiusY="5" Center="24,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M21.5,24 L23.5,26 L27,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ───── 计划分析 ───── -->

    <!-- 计划对比：两组柱状图并排（蓝=计划 / 绿=实际） -->
    <DrawingImage x:Key="plan_compare">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 计划组（蓝） -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="4,16,3,12"/>
                            <RectangleGeometry Rect="11,10,3,18"/>
                            <RectangleGeometry Rect="18,13,3,15"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 实际组（绿，紧贴右侧） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FF065F46" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="7,19,3,9"/>
                            <RectangleGeometry Rect="14,8,3,20"/>
                            <RectangleGeometry Rect="21,15,3,13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 图例：蓝点 + 绿点 -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="25,8,3,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="25,13,3,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 底轴 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,28 L30,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 报表生成：文档 + 内嵌饼图 + 文本行 -->
    <DrawingImage x:Key="plan_report">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 文档背景 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen><Pen Brush="#FF14B8A6" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6,4 L22,4 L26,8 L26,28 L6,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 折角 -->
                <GeometryDrawing Brush="#FFCCFBF1" Geometry="M22,4 L22,8 L26,8 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FF14B8A6" Thickness="0.6"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- 饼图 -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="3.5" RadiusY="3.5" Center="12,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFBBF24" Geometry="M12,12.5 L15.5,16 L12,16 Z"/>
                <GeometryDrawing Brush="#FFEF4444" Geometry="M12,16 L15.5,16 L15.5,19.5 L12,19.5 Z"/>
                <!-- 文本行 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M17,13 L23,13 M17,16 L23,16 M17,19 L21,19 M9,23 L23,23 M9,25.5 L20,25.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ─────────── 按 Needs.md 新增图标 ─────────── -->

    <!-- 中长远进度计划：日历 + 多年时间轴 + 蓝色长甘特条 -->
    <DrawingImage x:Key="plan_longterm">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen><Pen Brush="#FF14B8A6" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,5 L29,5 L29,28 L3,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部年份栏 -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF1E40AF" Offset="0"/>
                            <GradientStop Color="#FF1E3A8A" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,5,26,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部 5 年标记 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="6,7,2,1.5"/>
                            <RectangleGeometry Rect="11,7,2,1.5"/>
                            <RectangleGeometry Rect="16,7,2,1.5"/>
                            <RectangleGeometry Rect="21,7,2,1.5"/>
                            <RectangleGeometry Rect="26,7,2,1.5"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 蓝色长甘特条（横跨多年） -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="5,13,20,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFBBF24">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="9,18,15,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.6" RadiusY="0.6" Rect="13,23,12,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 短期生产计划：日历 + 周/月格 + 短紧凑甘特条 -->
    <DrawingImage x:Key="plan_shortterm">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen><Pen Brush="#FFFB923C" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,5 L29,5 L29,28 L3,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFFB923C" Offset="0"/>
                            <GradientStop Color="#FFEA580C" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,5,26,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 周日历网格（7 列）-->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFE5E7EB" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M7,10 L7,28 M11,10 L11,28 M15,10 L15,28 M19,10 L19,28 M23,10 L23,28 M27,10 L27,28 M3,15 L29,15 M3,21 L29,21"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 短紧凑甘特条 -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.5" RadiusY="0.5" Rect="5,12,8,2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.5" RadiusY="0.5" Rect="9,17,10,2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFEC4899">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="0.5" RadiusY="0.5" Rect="13,23,9,2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════════════════════════════════════════════════════════════
         按 Needs.md 未提交补充：3 个子分类共 12 个图标。
         立体派 / 32×32 viewBox。
         中长远组主色：蓝（#1E40AF）；短期组主色：橙（#EA580C）；模拟组主色：紫（#7C3AED）。
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ─────────── 中长远进度计划编制 · 5 个子图标 ─────────── -->

    <!-- 刀量切割：3D 矿体 + 红色刀片切割线 + 分割出的切片 -->
    <DrawingImage x:Key="plan_lt_cutting">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 3D 矿体顶面 -->
                <GeometryDrawing Brush="#FF93C5FD">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,12 L16,7 L27,12 L16,17 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 左侧面 -->
                <GeometryDrawing Brush="#FF60A5FA">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,12 L16,17 L16,27 L5,22 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 右侧面 -->
                <GeometryDrawing Brush="#FF1E40AF">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,17 L27,12 L27,22 L16,27 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 多条刀切痕迹（白色实线） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M9,10 L9,21.5 M13,8 L13,24 M19,8 L19,24 M23,10 L23,21.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 红色刀片（斜插切下来） -->
                <GeometryDrawing Brush="#FFEF4444">
                    <GeometryDrawing.Pen><Pen Brush="#FF7F1D1D" Thickness="0.6" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M22,2 L30,4 L29,8 L21,6 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFEF4444" Thickness="1.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M21,6 L13,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 剥采比均衡：天平 + 左盘"剥"褐色 + 右盘"采"金色 -->
    <DrawingImage x:Key="plan_lt_ratio_balance">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 天平立柱 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,8 L16,28 M11,28 L21,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 横梁 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1.6" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,9 L28,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中心支点 -->
                <GeometryDrawing Brush="#FF1E3A8A">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="16,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 左盘连线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,9 L3,16 M5,9 L7,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 左盘（剥离土黄褐色多边形） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFB45309" Offset="0"/>
                            <GradientStop Color="#FF7C2D12" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF451A03" Thickness="0.6" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,16 L8,16 L7,20 L3,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 右盘连线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M27,9 L25,16 M27,9 L29,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 右盘（采矿金黄） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFFBBF24" Offset="0"/>
                            <GradientStop Color="#FFD97706" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF92400E" Thickness="0.6" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M24,16 L30,16 L29,20 L25,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部"="均衡符号 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF10B981" Thickness="1.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M13,4 L19,4 M13,6.5 L19,6.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 派生计划方案（长期版，蓝色调）：主方案文档 + 分叉出 2 个派生子方案 -->
    <DrawingImage x:Key="plan_lt_derive">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 主方案（蓝色文档，左大） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFBFDBFE" Offset="0"/>
                            <GradientStop Color="#FF60A5FA" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,9 L11,9 L14,12 L14,24 L3,24 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.5"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,14 L12,14 M5,17 L12,17 M5,20 L10,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 分支连接线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M14,16.5 L20,8 M14,16.5 L20,25"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 派生子方案 1（右上） -->
                <GeometryDrawing Brush="#FFBFDBFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,3 L25,3 L28,6 L28,13 L20,13 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M21,7 L27,7 M21,9 L26,9 M21,11 L26,11"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 派生子方案 2（右下） -->
                <GeometryDrawing Brush="#FFBFDBFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,20 L25,20 L28,23 L28,30 L20,30 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M21,24 L27,24 M21,26 L26,26 M21,28 L26,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 分支节点（绿色实心圆） -->
                <GeometryDrawing Brush="#FF10B981">
