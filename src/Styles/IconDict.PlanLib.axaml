                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M10,5 L10,26 M16,5 L16,26 M22,5 L22,26"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 推进方向箭头（白，→） -->
