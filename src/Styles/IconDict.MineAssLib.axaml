                    <GeometryDrawing.Geometry><PathGeometry Figures="M2,28 L2,24 L17,18 L18,21.5 L4,28 Z"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 保留段黄实中线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFBBF24" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M3,26 L17,19.5"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 末段：正被撤销，虚化淡出（半透明灰 + 虚边） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FF9CA3AF" Opacity="0.4"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF6B7280" Thickness="0.7" LineJoin="Round">
                            <Pen.DashStyle><DashStyle Dashes="1.6,1.4"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M17,18 L28,12 L29,15.5 L18,21.5 Z"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 逆时针撤销箭头（绿色 ↺，移除最近一段） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF10B981" Thickness="2.2" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M25,9 A6.5,6.5 0 1 0 27.5,14.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 撤销箭头头部（指向起点，逆时针入口） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.4" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M25,9 L20,8.2 L23,12.8 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ─────────── 运输/排土 占位图标改专属 ─────────── -->

    <!-- 直线坑线：阶梯坑 + 一条贯穿坑底到地表的【直线】斜坡道（深灰带+黄虚中线）+ 绿上行箭头 -->
    <DrawingImage x:Key="mineass_road_straight">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 阶梯坑剖面 -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFFED7AA" Offset="0"/>
                            <GradientStop Color="#FF9A3412" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF7C2D12" Thickness="0.7" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,29 L2,23 L8,23 L8,17 L14,17 L14,11 L22,11 L22,7 L30,7 L30,29 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 台阶高光 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFBBF24" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,23.5 L8,23.5 M8,17.5 L14,17.5 M14,11.5 L22,11.5 M22,7.5 L30,7.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 直线斜坡道（贯穿，深灰带） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="3.4" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,27 L27,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 黄虚中线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="0.8"><Pen.DashStyle><DashStyle Dashes="1.6,1.2"/></Pen.DashStyle></Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,27 L27,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿色上行箭头（坑底→地表） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M28,7 L23.5,8 L26,12.5 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 平盘联络道：上下两级平盘 + 跨坡面的斜向联络路（深灰带+黄虚中线）连接两平盘 -->
    <DrawingImage x:Key="mineass_bench_connector">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 两级平盘 + 中间坡面（剖面） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFFED7AA" Offset="0"/>
                            <GradientStop Color="#FF9A3412" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF7C2D12" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,29 L2,23 L13,23 L19,13 L30,13 L30,29 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 平盘高光（上下两条） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFBBF24" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,23.5 L13,23.5 M19,13.5 L30,13.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 跨坡联络路（下平盘→上平盘，深灰带） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="3.2" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M8,23 L24,13"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 黄虚中线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="0.8"><Pen.DashStyle><DashStyle Dashes="1.6,1.2"/></Pen.DashStyle></Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M8,23 L24,13"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 两端联络端点（蓝色，强调"联络/对接两平盘"） -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.7" RadiusY="1.7" Center="8,23"/>
                            <EllipseGeometry RadiusX="1.7" RadiusY="1.7" Center="24,13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 排土场按量推进：左侧采空区（虚线空台阶）+ 右侧排土堆（安息角）+ 绿色推进箭头（给量往外堆） -->
    <DrawingImage x:Key="mineass_inner_dump">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 采空区（左，虚线空台阶轮廓） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFC2410C" Thickness="1.1" LineJoin="Round">
                            <Pen.DashStyle><DashStyle Dashes="2,1.4"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,29 L2,21 L8,21 L8,15 L13,15"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 排土堆（右，按安息角的料堆，土黄渐变） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFD4A373" Offset="0"/>
                            <GradientStop Color="#FF7C2D12" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF5C2A0E" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M14,29 L23,16 L30,16 L30,29 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 排土堆顶高光 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFDE68A" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M23,16.5 L30,16.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿色向左推进箭头（向采空区回填） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF10B981" Thickness="2.2" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M23,9 L11,9 M14,6 L11,9 L14,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 排土条带：俯视一级排土台阶被切成网格——土黄底 + 走向分幅虚线 + 推进方向实线带 + 当前工作面带高亮 -->
    <DrawingImage x:Key="mineass_dump_strip">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 台阶壳子（俯视矩形，土黄） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFE7C9A3" Offset="0"/>
                            <GradientStop Color="#FFC08A52" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF5C2A0E" Thickness="1.0" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,7 26,18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 当前排土工作面那一带（最左一条，绿色实心 = 真坡面所在） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,7 6,18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 条带界（沿推进方向逐带切开） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF5C2A0E" Thickness="0.9"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M9,7 L9,25 M15,7 L15,25 M21,7 L21,25"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 分幅界（沿走向切，虚线以示与条带不同轴） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF7C2D12" Thickness="0.8">
                            <Pen.DashStyle><DashStyle Dashes="2,1.4"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,13 L29,13 M3,19 L29,19"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 推进方向箭头（往坡脚/外，与采场镜像） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="1.8" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,4 L26,4 M23,1.5 L26,4 L23,6.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 煤层露头着色：台阶横剖面——鲜绿坡体 + 埋藏煤层暗带 + 台阶帮面露头段染煤色·亮橙高亮 -->
    <DrawingImage x:Key="mineass_seam_outcrop">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 土体横剖面（鲜绿地表）：左台面 → 台阶帮面下切 → 坑底 -->
                <GeometryDrawing Brush="#FF8BD450">
                    <GeometryDrawing.Pen><Pen Brush="#FF4F9E2C" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,11 L12,11 L16,25 L30,25 L30,29 L2,29 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 埋藏煤层暗带（顶底板之间，横卧于台面下，向帮面尖灭） -->
                <GeometryDrawing Brush="#FF242428">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,16 L12.5,18 L13.5,22 L2,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 现状面轮廓（深绿线，示意地表剖面下切） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF2F6B15" Thickness="1.3" LineJoin="Round" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,11 L12,11 L16,25 L30,25"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 露头着色高亮（亮橙描边光晕 = 着色动作） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFF7A14" Thickness="4.6" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="12.6,17.4" EndPoint="15.4,23.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 露头煤色芯（近黑，被染色的出露煤段） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1A1A1A" Thickness="2.6" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="12.6,17.4" EndPoint="15.4,23.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 着色点缀（亮黄小圆点，出露起点） -->
                <GeometryDrawing Brush="#FFFFC42B">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="1.7" RadiusY="1.7" Center="12.6,17.4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 连接台阶线：俯视一圈台阶线——两段原有橙色台阶线段 + 两处绿色新接上的接缝 + 接头绿夹点 -->
    <DrawingImage x:Key="mineass_bench_join">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 原有台阶线段（橙，上下两段，中间左右各缺一口） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFC2410C" Thickness="2.6" LineJoin="Round" LineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,11 L16,5 L27,11 M27,22 L16,28 L5,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 台阶线高光（浅橙描一道，和其它台阶类图标同一视觉语言） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFDBA74" Thickness="0.9" LineJoin="Round" LineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,11 L16,5 L27,11 M27,22 L16,28 L5,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 新接上的两处接缝（亮绿 = 本命令补上的连接关系，串成整圈） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF10B981" Thickness="2.6" LineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M27,11 L27,22 M5,22 L5,11"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 四个接头（绿点白边 = 首尾重合的端点被吸合） -->
                <GeometryDrawing Brush="#FF059669">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="27,11"/>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="27,22"/>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="5,22"/>
                            <EllipseGeometry RadiusX="1.9" RadiusY="1.9" Center="5,11"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

