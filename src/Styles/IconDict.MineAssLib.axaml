<!-- 由 build/convert_icons.py 从原版自动 1:1 转换，勿手改 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      MineAssLib 模块专属图标字典。
      由 MineAssLibPlugin.Initialize() 通过 IResourceRegistry.MergeResourceDictionary
      合并进 Application.Resources。
      当前 "mineass" 复用 PointCloudLib 的点云造型作为占位，后续按业务画专属图标时
      只改这一个文件。
    -->

    <!-- 剥采排工程 Tab 图标：露天矿坑剖面（阶梯下降）+ 天空 + 顶部小卡车 -->
    <DrawingImage x:Key="mineass">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 天空背景（蓝→米黄渐变） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFDBEAFE" Offset="0"/>
                            <GradientStop Color="#FFFEF3C7" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,4,28,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 阶梯坑剖面（橙→深棕渐变） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFEA580C" Offset="0"/>
                            <GradientStop Color="#FF7C2D12" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF451A03" Thickness="0.7" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,12 L8,12 L8,16 L14,16 L14,20 L20,20 L20,24 L30,24 L30,28 L2,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 台阶顶高光线（金黄） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="0.7" LineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,12.5 L8,12.5 M8,16.5 L14,16.5 M14,20.5 L20,20.5 M20,24.5 L30,24.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶层小卡车（黄车身） -->
                <GeometryDrawing Brush="#FFFBBF24">
                    <GeometryDrawing.Pen><Pen Brush="#FF7C2D12" Thickness="0.4" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,9 L7,9 L7,11.5 L6.5,11.5 L6.5,11 L3.5,11 L3.5,11.5 L3,11.5 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 卡车轮 -->
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="0.7" RadiusY="0.7" Center="3.8,11.7"/>
                            <EllipseGeometry RadiusX="0.7" RadiusY="0.7" Center="6.2,11.7"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ───── 工程量计算 ───── -->

    <!-- 体积计算：3D 立方体 + 测量箭头 -->
    <!-- 排土场容量校核：按安息角的排弃料堆 + 容量上限线 + 校核对勾（排弃量 vs 容量） -->
    <DrawingImage x:Key="mineass_volume">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 容量上限线（红虚水平线，设计排土容量上沿） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEF4444" Thickness="1" LineCap="Round">
                            <Pen.DashStyle><DashStyle Dashes="2,1.4"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,11 L29,11"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 排弃料堆（按安息角的对称土堆，土黄渐变） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFD4A373" Offset="0"/>
                            <GradientStop Color="#FF7C2D12" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF5C2A0E" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,27 L15,14 L26,27 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 料堆顶高光（安息角顶线提示） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFDE68A" Thickness="0.6" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6.5,24 L15,14.7 L23.5,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 地面线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,27.4 L30,27.4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 容量校核对勾（绿，堆顶在容量线之下=通过） -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.5"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="4" RadiusY="4" Center="26,6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.2" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M24,6 L25.5,7.6 L28.2,4.2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 进度对比：三根递增柱 + 计划虚线 -->
    <DrawingImage x:Key="mineass_progress">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 实际柱 -->
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="5,20,5,8"/>
                            <RectangleGeometry Rect="14,14,5,14"/>
                            <RectangleGeometry Rect="23,8,5,20"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 计划虚线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFEF4444" Thickness="1.2">
                            <Pen.DashStyle><DashStyle Dashes="2,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,22 L7,22 L7,16 L11,16 L11,10 L15,10 L15,5 L29,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 底轴 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,28 L30,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 验收：剪贴板 + 绿色对勾 -->
    <DrawingImage x:Key="mineass_accept">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 剪贴板背景 -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="0.9" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M7,7 L25,7 L25,28 L7,28 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 顶部夹子 -->
                <GeometryDrawing Brush="#FF6B7280">
                    <GeometryDrawing.Pen><Pen Brush="#FF1F2937" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,4 L20,4 L21,8 L11,8 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 内容线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,13 L22,13 M10,16 L20,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 大绿对勾 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF10B981" Thickness="2.6" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,22 L15,26 L23,18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ─────────── 按 Needs.md 新增图标 ─────────── -->

    <!-- 排土模板：按安息角(~35°)的排弃料堆 + 参数滑块 —— 与 mineass_template_param（采场模板）区分 -->
    <DrawingImage x:Key="mineass_dump_template">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 料堆（绿，梯形=安息角） -->
                <GeometryDrawing Brush="#FF34D399">
                    <GeometryDrawing.Pen><Pen Brush="#FF065F46" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,27 L9,14 L19,14 L26,27 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 安息角弧 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF065F46" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,27 A 6,6 0 0 1 5.2,21.8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 参数滑块（两根，表明这是"模板/参数"） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="1.6" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M14,5 L30,5 M14,10 L30,10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF2563EB">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="2.6" RadiusY="2.6" Center="26,5"/>
                            <EllipseGeometry RadiusX="2.6" RadiusY="2.6" Center="19,10"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 外排放坡：排土台阶【向上堆】+ 向上箭头 —— 与 mineass_bench_expand_batch（采场向下扩帮）方向相反 -->
    <DrawingImage x:Key="mineass_outer_dump_slope">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 逐级堆高的排土台阶（绿） -->
                <GeometryDrawing Brush="#FF6EE7B7">
                    <GeometryDrawing.Pen><Pen Brush="#FF065F46" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,29 L2,23 L11,23 L11,17 L20,17 L20,11 L29,11 L29,29 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 台阶面分界 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF065F46" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M11,23 L11,29 M20,17 L20,29"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 向上堆的箭头（三根） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF047857" Thickness="1.5"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6.5,21 L6.5,15 M15.5,15 L15.5,9 M24.5,9 L24.5,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF047857">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M6.5,12.5 L4,17 L9,17 Z"/>
                            <PathGeometry Figures="M15.5,6.5 L13,11 L18,11 Z"/>
                            <PathGeometry Figures="M24.5,1 L22,5.5 L27,5.5 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 驱动量：工作帮斜面 + 吨位砝码 + 左右双向箭头（用量反算位置）—— 与 mineass_volume（排土容量校核）区分 -->
    <DrawingImage x:Key="mineass_qty_driven">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 煤层（黑）+ 现状面 -->
                <GeometryDrawing Brush="#FF1F2937">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="2,22,28,4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 工作帮斜面（贯穿煤层） -->
                <GeometryDrawing Brush="#FFFDBA74">
                    <GeometryDrawing.Pen><Pen Brush="#FF7C2D12" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,26 L18,10 L24,10 L24,26 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 位置由量反算：左右双向箭头 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFDC2626" Thickness="1.5" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M7,29 L27,29"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFDC2626">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M3,29 L8,26.6 L8,31.4 Z"/>
                            <PathGeometry Figures="M31,29 L26,26.6 L26,31.4 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 砝码（量）：梯形块 -->
                <GeometryDrawing Brush="#FF2563EB">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.9" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,17 L5,9 L11,9 L13,17 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M6,13.5 L10,13.5"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 组合工作线：两条成员线 + 缺口处的虚线【软连接段】—— 与 mineass_workline（单条）区分 -->
    <DrawingImage x:Key="mineass_workline_group">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 成员线 ①（实） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="2.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M2,22 L7,15 L12,18"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 软连接段（虚线，不是实几何） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF94A3B8" Thickness="1.8" LineCap="Round">
                            <Pen.DashStyle><DashStyle Dashes="1.5,1.5"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M12,18 L18,14"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 成员线 ②（实） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="2.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M18,14 L23,17 L30,9"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 统一推进方向（琥珀箭头，与场景同色） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFF59E0B" Thickness="1.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M6,28 L16,28 M20,28 L26,28"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFF59E0B">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M19,28 L15,26 L15,30 Z"/>
                            <PathGeometry Figures="M30,28 L25,26 L25,30 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 成员端点夹点 -->
                <GeometryDrawing Brush="#FF2563EB">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="2" RadiusY="2" Center="12,18"/>
                            <EllipseGeometry RadiusX="2" RadiusY="2" Center="18,14"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 螺旋坑线：坑的同心环 + 盘旋下降的坡道弧 + 下行箭头 —— 与 mineass_road_straight（一条直腿）区分 -->
    <DrawingImage x:Key="mineass_vertical_curve">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 原折线纵断面(灰): 两直坡在变坡点成尖角 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="1.4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M4,26 L16,7 L28,26"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 平滑竖曲线(青): 直坡→抛物线→直坡, 削平尖角 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF22D3EE" Thickness="2.6" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M4,26 L9,18 Q16,9 23,18 L28,26"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 变坡点标记 -->
                <GeometryDrawing Brush="#FFF59E0B">
                    <GeometryDrawing.Geometry><EllipseGeometry RadiusX="1.8" RadiusY="1.8" Center="16,7"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="mineass_road_spiral">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 坑的同心台阶环（俯视） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFCBD5E1" Thickness="1.2"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="14" RadiusY="7" Center="16,14"/>
                            <EllipseGeometry RadiusX="9.5" RadiusY="4.8" Center="16,17"/>
                            <EllipseGeometry RadiusX="5" RadiusY="2.6" Center="16,20"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 盘旋下降的坡道（沿环走的弧段，逐圈收小） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF374151" Thickness="2.6" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M30,14 A 14,7 0 0 1 16,21 M6.5,17 A 9.5,4.8 0 0 1 16,12.2 M21,20 A 5,2.6 0 0 1 11,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 黄色路面中线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="0.8">
                            <Pen.DashStyle><DashStyle Dashes="2,1.5"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M30,14 A 14,7 0 0 1 16,21 M6.5,17 A 9.5,4.8 0 0 1 16,12.2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 下行箭头 -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry><PathGeometry Figures="M16,29 L12.5,23.5 L19.5,23.5 Z"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 折返坑线：直腿 + 180° 回头弧往返下降 —— 与 mineass_road_centerline（手画之字中线 + 画笔）区分 -->
    <DrawingImage x:Key="mineass_road_switchback">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 坡面底衬 -->
                <GeometryDrawing Brush="#FFF5F5F4">
                    <GeometryDrawing.Pen><Pen Brush="#FFD6D3D1" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="1" RadiusY="1" Rect="2,4,28,25"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 折返路：直腿 + 两个 180° 回头弧 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF374151" Thickness="2.8" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,26 L21,26 A 4,4 0 0 0 21,18 L9,18 A 4,4 0 0 1 9,10 L26,10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 黄色中线 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="0.8">
                            <Pen.DashStyle><DashStyle Dashes="2,1.5"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,26 L21,26 A 4,4 0 0 0 21,18 L9,18 A 4,4 0 0 1 9,10 L26,10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 上行端箭头 -->
                <GeometryDrawing Brush="#FF10B981">
                    <GeometryDrawing.Geometry><PathGeometry Figures="M30,10 L25,7.4 L25,12.6 Z"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 参数化开采模板设计：模板矩形 + 参数滑块 -->
    <DrawingImage x:Key="mineass_template_param">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 模板背板 -->
                <GeometryDrawing Brush="#FFFEF3C7">
                    <GeometryDrawing.Pen><Pen Brush="#FF92400E" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="1.5" RadiusY="1.5" Rect="3,5,26,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 模板里的阶梯（开采台阶示意） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF92400E" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,22 L11,22 L11,18 L17,18 L17,14 L23,14 L23,10 L27,10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 右侧 3 个参数滑块（蓝色） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF93C5FD" Thickness="1.6" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,8 L29,8 M20,16 L29,16 M20,24 L29,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF2563EB">
