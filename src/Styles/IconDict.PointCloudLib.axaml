                            <EllipseGeometry RadiusX="1.0" RadiusY="1.0" Center="15,25"/>
                            <EllipseGeometry RadiusX="1.0" RadiusY="1.0" Center="21,21"/>
                            <EllipseGeometry RadiusX="1.0" RadiusY="1.0" Center="29,24"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 分割点云：散点点云 + 闭合套索多边形（圈内高亮蓝 / 圈外淡灰） -->
    <DrawingImage x:Key="pc_crop_cloud">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 圈外的点（淡灰，被裁掉） -->
                <GeometryDrawing Brush="#FFCBD5E1">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="4,6"/>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="28,5"/>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="29,16"/>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="5,27"/>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="26,28"/>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="3,17"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 套索多边形（闭合，半透明填充 + 实线边） -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FF3B82F6" Opacity="0.15"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="1.4" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="16,7" IsClosed="True">
                                <LineSegment Point="24,11"/>
                                <LineSegment Point="23,21"/>
                                <LineSegment Point="14,25"/>
                                <LineSegment Point="8,18"/>
                                <LineSegment Point="9,11"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 圈内的点（高亮蓝，保留） -->
                <GeometryDrawing Brush="#FF2563EB">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="14,11"/>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="19,12"/>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="12,16"/>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="17,16"/>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="20,17"/>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="15,20"/>
                            <EllipseGeometry RadiusX="1.3" RadiusY="1.3" Center="18,21"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 清除点云：一片点云(深点)被红色斜线扫除(部分点淡化消失)，动作色=删除红 -->
    <DrawingImage x:Key="pc_view_clean">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 残留点云（深 slate，左下侧未扫到） -->
                <GeometryDrawing Brush="#FF334155">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="6,24"/>
                            <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="11,26"/>
                            <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="7,18"/>
                            <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="13,21"/>
                            <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="17,26"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 被清除中的点（淡灰，右上侧正被扫除消散） -->
                <GeometryDrawing Brush="#FFCBD5E1">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.2" RadiusY="1.2" Center="20,9"/>
                            <EllipseGeometry RadiusX="1.1" RadiusY="1.1" Center="25,7"/>
                            <EllipseGeometry RadiusX="1.0" RadiusY="1.0" Center="26,13"/>
                            <EllipseGeometry RadiusX="0.9" RadiusY="0.9" Center="22,5"/>
                            <EllipseGeometry RadiusX="0.8" RadiusY="0.8" Center="28,9"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 红色扫除斜线（动作色=删除） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFEF4444" Thickness="2.4" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry><PathFigure StartPoint="8,26"><LineSegment Point="27,5"/></PathFigure></PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
