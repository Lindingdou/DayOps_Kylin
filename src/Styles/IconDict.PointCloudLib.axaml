    <!-- 补充空洞：曲面中央空洞 + 青色补丁填入 -->
    <DrawingImage x:Key="pc_fill_hole">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 曲面（带空洞） -->
                <GeometryDrawing Brush="#FFDBEAFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="1.0" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="3,22" IsClosed="True">
                                <LineSegment Point="29,22"/>
                                <LineSegment Point="26,28"/>
                                <LineSegment Point="6,28"/>
                            </PathFigure>
                            <PathFigure StartPoint="14,24" IsClosed="True">
                                <BezierSegment Point1="13,26" Point2="19,26" Point3="18,24"/>
                                <BezierSegment Point1="19,23" Point2="13,23" Point3="14,24"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 三角网线（提示是曲面） -->
