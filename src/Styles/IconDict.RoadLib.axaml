<!-- 由 build/convert_icons.py 从原版自动 1:1 转换，勿手改 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      RoadLib 模块专属图标字典。
      由 RoadLibPlugin.Initialize() 通过 IResourceRegistry.MergeResourceDictionary
      合并进 Application.Resources。

      ══ 2026-08-09 全库重画：对齐【模块家族】（不是 Host/Home 那一族）══
      ⚠ 本仓库有**两套**图标风格，别对错参照物：
        · Host/Home 家族（icon_new / icon_open）：白纸 + 深描边 + 单色点缀 —— 文件/剪贴板那些
        · **模块家族**（MineAssLib / PlanLib / PointCloudLib / GeoDataBase）：
          **暖色渐变实体、直接画对象本身、不套白底方框**、细描边取自填充的深色、
          需要几种颜色就用几种（台阶=棕橙、路面=灰、通过=绿、数据=蓝、禁止/峰值=红）
      道路运输 tab 的邻居是 剥采排 / 点云 / 生产计划编制，全是**模块家族**，
      所以这本字典按模块家族画。第一版误对齐到 Host 家族（每个图标套白框），现场连提三次不像，已推倒重来。

      调色（与 MineAssLib 一致）：
        台阶/地形  #FFD98E4A → #FF8B4A1E   描边 #FF7C3A12
        路面/沥青  #FF9CA3AF → #FF4B5563   描边 #FF374151    中线 #FFFBBF24
        绿(通过)   #FF34D399 → #FF10B981   描边 #FF047857
        蓝(数据)   #FF60A5FA → #FF2563EB   描边 #FF1E40AF
        橙(强调)   #FFFB923C → #FFEA580C   描边 #FF9A3412
        红(禁止)   #FFF87171 → #FFDC2626   描边 #FF991B1B

      ⚠ 本文件里 **x:Key 不许重复** —— ResourceDictionary 加载遇到重复键会抛异常并
        **作废整本字典**，那个 tab 的所有图标（含 Tab 图标）会一起消失，而构建全绿、运行不报错。
        提交 764fdcf 就带进过一份重复的 road_trigger，整条 tab 的图标全灭。判据 S42 已钉住这条。
    -->

    <!-- ══════════ Tab 图标 ══════════ -->

    <!-- 道路运输系统：棕色远山 + 灰色透视路面 + 黄虚中线 -->
    <DrawingImage x:Key="road">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M1,15 L9,5 L15,12 L21,6 L31,15 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFD98E4A" Offset="0"/><GradientStop Color="#FF8B4A1E" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF7C3A12" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M12,13 L20,13 L30,30 L2,30 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF9CA3AF" Offset="0"/><GradientStop Color="#FF4B5563" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF374151" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M16,15 L16,28">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="2.2" LineCap="Round">
                            <Pen.DashStyle><DashStyle Dashes="1.5,1.2"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ══════════ ① 路网构建 ══════════ -->

    <!-- 手动标定线路：棕台阶坡面 + 蓝手绘中线 + 蓝夹点 + 绿笔 -->
    <DrawingImage x:Key="road_mark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M2,29 L2,22 L10,22 L10,15 L18,15 L18,8 L30,8 L30,29 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFD98E4A" Offset="0"/><GradientStop Color="#FF8B4A1E" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF7C3A12" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M4,27 L11,20 L19,13 L28,10">
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="2.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF60A5FA">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="2.2,25.2,3.6,3.6"/>
                            <RectangleGeometry Rect="9.2,18.2,3.6,3.6"/>
                            <RectangleGeometry Rect="17.2,11.2,3.6,3.6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M22,15 L29,3 L31,4.6 L25,17 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#FF34D399" Offset="0"/><GradientStop Color="#FF10B981" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF047857" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 删除道路中心线：灰中线折线 + 黄芯 + 蓝夹点（= 一条已标定的中线）+ 压在上面的红叉（去掉它）
         ⚠ 2026-08-11 起功能区已不用它 —— 那个钮升级成「中心线管理」，改用下面的 road_centerline_manage。
         键留着不删：字典里多一个没人引用的键无害，删了反而让"这枚图标画的是什么"这段来历断掉。 -->
    <DrawingImage x:Key="road_erase">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M3,29 L12,22 L21,24 L29,17">
                    <GeometryDrawing.Pen><Pen Brush="#FF4B5563" Thickness="3.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M3,29 L12,22 L21,24 L29,17">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="1.3">
                            <Pen.DashStyle><DashStyle Dashes="2,1.4"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF60A5FA">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="1.4,27.4,3.2,3.2"/>
                            <RectangleGeometry Rect="10.4,20.4,3.2,3.2"/>
                            <RectangleGeometry Rect="19.4,22.4,3.2,3.2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M17,3 L29,15 M29,3 L17,15">
                    <GeometryDrawing.Pen><Pen Brush="#FFDC2626" Thickness="3.8" LineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 中心线管理：左边一张蓝色清单（三行白条 = 逐条中线摊成表），右边那条已标定的中线
         （灰身 + 黄虚芯 + 蓝夹点，与上面 road_erase 同一母题），底下一枚红叉小标 = 清单里能删。
         替代原「删除道路中心线」的 road_erase（那枚整块红叉，现在的入口不止于删）。 -->
    <DrawingImage x:Key="road_centerline_manage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M2,3 L15,3 L15,23 L2,23 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF60A5FA" Offset="0"/><GradientStop Color="#FF2563EB" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFF8FAFC">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="4.2,6.4,8.6,2.2"/>
                            <RectangleGeometry Rect="4.2,11.4,8.6,2.2"/>
                            <RectangleGeometry Rect="4.2,16.4,8.6,2.2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M18,26 L23,17 L27,18 L31,9">
                    <GeometryDrawing.Pen><Pen Brush="#FF4B5563" Thickness="3.4" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M18,26 L23,17 L27,18 L31,9">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFBBF24" Thickness="1.3">
                            <Pen.DashStyle><DashStyle Dashes="2,1.4"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF60A5FA">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="21.4,15.4,3.2,3.2"/>
                            <RectangleGeometry Rect="29.4,7.4,3.2,3.2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M4.5,25.5 L10.5,31.5 M10.5,25.5 L4.5,31.5">
                    <GeometryDrawing.Pen><Pen Brush="#FFDC2626" Thickness="2.6" LineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

