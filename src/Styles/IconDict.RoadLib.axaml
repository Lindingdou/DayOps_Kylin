    <!-- 时段快照：层叠的路网帧 + 蓝时钟 -->
    <DrawingImage x:Key="road_snapshot">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFD98E4A" Geometry="M9,2 L30,2 L30,18 L9,18 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FF7C3A12" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
