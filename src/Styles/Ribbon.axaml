<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 顶部 Ribbon 标签控件 ============ -->
    <Style Selector="TabControl.ribbon">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#EEF1F5" />
    </Style>
    <Style Selector="TabControl.ribbon > TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TabControl.ribbon > TabItem:selected">
        <Setter Property="Foreground" Value="#0A5AD4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============ 分组容器 ============ -->
    <Style Selector="Border.ribbon-group">
        <Setter Property="Padding" Value="3,2,3,1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="BorderBrush" Value="#DCDFE4" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="TextBlock.ribbon-caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#8A9099" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ============ Ribbon 按钮：扁平 + 悬停高亮 ============ -->
    <Style Selector="Button.ribbon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ribbon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1A0A5AD4" />
    </Style>
    <Style Selector="Button.ribbon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#330A5AD4" />
    </Style>
    <Style Selector="Button.ribbon-btn Image">
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- 大按钮：竖排 图标 + 文字 -->
    <Style Selector="Button.large">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="66" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.large Image">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Button.large TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- 小按钮：横排 图标 + 文字。压 MinHeight（FluentTheme 默认 32）+ 减竖向内边距，
         保证 3 个塞进一列（DayOps 的 3 行 × N 列布局）。 -->
    <Style Selector="Button.small">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.small TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,2,0" />
    </Style>

    <!-- ToggleButton 版 ribbon 大按钮(帮助/AI 助手, 同原版 Fluent:ToggleButton Large) -->
    <Style Selector="ToggleButton.ribbon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.ribbon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1A0A5AD4" />
    </Style>
    <Style Selector="ToggleButton.ribbon-btn:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#330A5AD4" />
    </Style>
    <!-- 状态栏小开关(正交/捕捉/栅格/栅格捕捉)：默认透明, 选中=淡蓝底 + 蓝描边(不再是整块实心蓝, 图标看得清) -->
    <Style Selector="ToggleButton.status-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.status-toggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#14000000" />
        <Setter Property="BorderBrush" Value="#33000000" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#260A5AD4" />
        <Setter Property="BorderBrush" Value="#990A5AD4" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3D0A5AD4" />
        <Setter Property="BorderBrush" Value="#CC0A5AD4" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#520A5AD4" />
    </Style>

    <Style Selector="ToggleButton.large">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="66" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.large Image">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="ToggleButton.large TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

</Styles>
