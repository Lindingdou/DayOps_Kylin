                <GeometryDrawing Brush="#FFFEF3C7"><GeometryDrawing.Pen><Pen Brush="#FFB45309" Thickness="0.8"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry RadiusX="1" RadiusY="1" Rect="3,8,26,20"/></GeometryDrawing.Geometry></GeometryDrawing>
