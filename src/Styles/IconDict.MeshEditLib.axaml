<!-- 由 build/convert_icons.py 从原版自动 1:1 转换，勿手改 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      MeshEditLib 模块专属图标字典。
      由 MeshEditLibPlugin.Initialize() 通过 IResourceRegistry.MergeResourceDictionary
      合并进 Application.Resources，让 Ribbon 注册的 iconKey 能解析到这里的资源。
      新增三维建模 / 三角网 / 块体 相关图标只改这一个文件。
    -->

    <!-- 三维地质建模图标（蓝色立方体+黄色提示+剖切虚线）
         viewBox 0 0 32 32 -->
