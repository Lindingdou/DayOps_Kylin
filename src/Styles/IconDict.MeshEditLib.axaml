    <!-- 创建三角网：离散顶点 → 约束 Delaunay TIN（浅蓝三角面 + 绿色约束线 + 顶点） -->
    <DrawingImage x:Key="icon_Triangle">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- TIN 三角面（浅蓝填充 + 蓝边） -->
                <GeometryDrawing Brush="#FFBFDBFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="0.7" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M5,26 L14,28 L10,18 Z"/>
                            <PathGeometry Figures="M14,28 L10,18 L20,16 Z"/>
                            <PathGeometry Figures="M14,28 L24,26 L20,16 Z"/>
                            <PathGeometry Figures="M24,26 L29,18 L20,16 Z"/>
                            <PathGeometry Figures="M10,18 L4,13 L15,9 Z"/>
                            <PathGeometry Figures="M10,18 L20,16 L15,9 Z"/>
                            <PathGeometry Figures="M20,16 L15,9 L26,8 Z"/>
                            <PathGeometry Figures="M20,16 L29,18 L26,8 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 绿色约束线（约束 Delaunay 的强制边） -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF059669" Thickness="1.8" LineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,13 L15,9 L26,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 内部顶点（深蓝） -->
                <GeometryDrawing Brush="#FF1E3A8A">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="5,26"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="14,28"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="24,26"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="29,18"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="10,18"/>
                            <EllipseGeometry RadiusX="1" RadiusY="1" Center="20,16"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 约束线顶点（绿色高亮） -->
                <GeometryDrawing Brush="#FF059669">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.5"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="1.5" RadiusY="1.5" Center="4,13"/>
                            <EllipseGeometry RadiusX="1.5" RadiusY="1.5" Center="15,9"/>
                            <EllipseGeometry RadiusX="1.5" RadiusY="1.5" Center="26,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ───── 格网数据处理 ───── -->

    <!-- 网格平滑：锯齿 → 平滑曲线 + 中间向下箭头 -->
    <DrawingImage x:Key="mesh_smooth">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="1.6" LineJoin="Miter"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,10 L8,5 L12,11 L16,5 L20,11 L24,5 L28,10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF2563EB" Geometry="M14,14 L18,14 L18,17 L21,17 L16,22 L11,17 L14,17 Z"/>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="2" LineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,27 C8,23 12,29 16,26 C20,23 24,29 28,27"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 网格简化：左侧密三角网 → 右侧大三角 -->
    <DrawingImage x:Key="mesh_simplify">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFBFDBFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,22 L9,22 L6,12 Z M9,22 L15,22 L12,12 Z M6,12 L12,12 L9,4 Z M9,12 L15,12 L12,4 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1F2937" Geometry="M16,12 L20,12 L20,11 L24,13 L20,15 L20,14 L16,14 Z"/>
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M19,24 L29,24 L24,8 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 修补孔洞：三角网带洞 + 黄色补丁 -->
    <DrawingImage x:Key="mesh_repair">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFBFDBFE">
                    <GeometryDrawing.Pen><Pen Brush="#FF2563EB" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,28 L11,28 L7,20 Z M11,28 L19,28 L15,20 Z M19,28 L27,28 L23,20 Z M7,20 L15,20 L11,12 Z M15,20 L23,20 L19,12 Z M11,12 L19,12 L15,4 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="M15,20 L23,20 L19,12 Z"/>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFBBF24" Opacity="0.85"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFB45309" Thickness="1" LineJoin="Round">
                            <Pen.DashStyle><DashStyle Dashes="2,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M15,20 L23,20 L19,12 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- =================================================================
         Needs.md 2026-05-25 15:00 规格 — MeshEditLib 43+ 新图标
         建模 (4 新 L) / 基础模型编辑 (15 M) / 三角网体素编辑 (14 M)
         地质统计学 (2 L) / 块体模型 (2L+6M)
         "创建三角网"复用 Host 共享 icon_triangle，不重复定义。
         立体派统一画风。L 用 32×32 ; M 用 16×16。
         ================================================================= -->

    <!-- ─────────── 建模组 (Large 32×32) ─────────── -->

    <!-- 展点：散布彩色点云在浅蓝底图上 -->
    <DrawingImage x:Key="mb_show_pts">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFE0F2FE">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="1" RadiusY="1" Rect="3,6,26,22"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF93C5FD" Thickness="0.4">
                            <Pen.DashStyle><DashStyle Dashes="1,1"/></Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,13 L29,13 M3,21 L29,21 M11,6 L11,28 M21,6 L21,28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFEF4444"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="7,10"/><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="14,9"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFFBBF24"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="9,17"/><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="19,12"/><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="25,15"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF10B981"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="13,22"/><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="20,24"/><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="26,22"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF3B82F6"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="6,24"/><EllipseGeometry RadiusX="1.6" RadiusY="1.6" Center="16,18"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 侧面三角网：3D 立方体 + 侧面三角化线 -->
    <DrawingImage x:Key="mb_side_tri">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 立方体三个面 -->
                <GeometryDrawing Brush="#FF93C5FD"><GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M6,10 L16,5 L26,10 L16,15 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF60A5FA"><GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M6,10 L16,15 L16,28 L6,23 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <!-- 右侧三角网（高亮蓝面 + 内三角线） -->
                <GeometryDrawing Brush="#FF1E40AF"><GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M16,15 L26,10 L26,23 L16,28 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFBBF24" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,15 L26,23 M16,28 L26,10 M21,12.5 L21,25.5 M16,21 L26,16.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 固化成体：面网格 + 箭头 → 实心 cube -->
    <DrawingImage x:Key="mb_solidify">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 左侧线框 cube -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,12 L8,8 L13,12 L8,16 Z M3,12 L3,22 L8,26 L13,22 L13,12 M8,16 L8,26"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 中间箭头 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFB923C" Thickness="1.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M14,17 L19,17"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFB923C" Geometry="M19,17 L16,15 L16,19 Z"/>
                <!-- 右侧实心 cube -->
                <GeometryDrawing Brush="#FF60A5FA"><GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M20,12 L25,8 L30,12 L25,16 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF3B82F6"><GeometryDrawing.Pen><Pen Brush="#FF1E40AF" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M20,12 L25,16 L25,26 L20,22 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF1E40AF"><GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M25,16 L30,12 L30,22 L25,26 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 地质体建模：彩色多层 3D 地质体 -->
    <DrawingImage x:Key="mb_geomodel">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFBBF24"><GeometryDrawing.Pen><Pen Brush="#FF92400E" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M5,8 L16,3 L27,8 L16,13 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF10B981"><GeometryDrawing.Pen><Pen Brush="#FF064E3B" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M5,8 L16,13 L16,17 L5,12 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF059669"><GeometryDrawing.Pen><Pen Brush="#FF064E3B" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M16,13 L27,8 L27,12 L16,17 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF3B82F6"><GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M5,12 L16,17 L16,21 L5,16 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF1E40AF"><GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M16,17 L27,12 L27,16 L16,21 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFEA580C"><GeometryDrawing.Pen><Pen Brush="#FF7C2D12" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M5,16 L16,21 L16,28 L5,23 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF7C2D12"><GeometryDrawing.Pen><Pen Brush="#FF451A03" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M16,21 L27,16 L27,23 L16,28 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 补勘钻孔写实：地层柱(煤层分色带 + 深度刻度) + 橙色「+」徽标(补勘/写实录入) -->
    <DrawingImage x:Key="mu_borehole">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 柱身 -->
                <GeometryDrawing Brush="#FFF1F5F9">
                    <GeometryDrawing.Pen><Pen Brush="#FF334155" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry RadiusX="1.5" RadiusY="1.5" Rect="6,3,10,26"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 煤层分色带(4/9/11 号煤层色) -->
                <GeometryDrawing Brush="#FFD4A017"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,8,10,3"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF4A7C2E"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,14,10,2.6"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF2C5F8D"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,20,10,3"/></GeometryDrawing.Geometry></GeometryDrawing>
                <!-- 深度刻度 -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FF94A3B8" Thickness="0.7"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M3.5,8 L6,8 M3.5,14 L6,14 M3.5,20 L6,20 M3.5,26 L6,26"/></GeometryDrawing.Geometry>
