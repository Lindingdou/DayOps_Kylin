    <!-- 点编辑：3 个聚类的彩色高亮点 + 中心圆环（编辑标志） -->
    <DrawingImage x:Key="edit_point">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF3B82F6">
                    <GeometryDrawing.Pen><Pen Brush="#FF1E3A8A" Thickness="0.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry RadiusX="2" RadiusY="2" Center="4,5"/>
                            <EllipseGeometry RadiusX="2" RadiusY="2" Center="12,5"/>
                            <EllipseGeometry RadiusX="2" RadiusY="2" Center="4,13"/>
                            <EllipseGeometry RadiusX="2" RadiusY="2" Center="12,13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFF59E0B">
                    <GeometryDrawing.Pen><Pen Brush="#FF92400E" Thickness="0.8"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="2.8" RadiusY="2.8" Center="8,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFDC2626" Thickness="0.8">
                            <Pen.DashStyle>
                                <!-- DashStyle 是对象不是字符串：必须用 <DashStyle Dashes=".."/>，
                                     不能写 DashStyle="2,1"（运行期 lazy 解析时 ArgumentException → 整个 IconDict 加载失败 → MeshEditLib Initialize 崩溃）。 -->
                                <DashStyle Dashes="2,1"/>
                            </Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="4.5" RadiusY="4.5" Center="8,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

