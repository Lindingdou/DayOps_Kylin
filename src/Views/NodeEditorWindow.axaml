<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PitMine3D.Kylin.Views.NodeEditorWindow"
        Title="节点编辑器" Width="900" Height="600"
        Background="#FBFBFD">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" Spacing="4">
            <TextBlock Text="参数:" VerticalAlignment="Center" Foreground="#555" />
            <Button Content="数字" Tag="Number" Click="OnAddNode" />
            <Button Content="点" Tag="Point" Click="OnAddNode" />
            <Button Content="文本" Tag="String" Click="OnAddNode" />
            <Button Content="布尔" Tag="Bool" Click="OnAddNode" />
            <TextBlock Text="几何:" VerticalAlignment="Center" Foreground="#555" Margin="8,0,0,0" />
            <Button Content="直线" Tag="Line" Click="OnAddNode" />
            <Button Content="圆" Tag="Circle" Click="OnAddNode" />
            <Button Content="圆弧" Tag="Arc" Click="OnAddNode" />
            <Button Content="矩形" Tag="Rectangle" Click="OnAddNode" />
            <Button Content="多边形" Tag="Polygon" Click="OnAddNode" />
            <Button Content="多段线" Tag="Polyline" Click="OnAddNode" />
            <Button Content="烘焙" Tag="Bake" Click="OnAddNode" />
            <Button Content="▶ 求值到场景" Click="OnBakeToScene" Background="#2E7D32" Foreground="White" Margin="8,0,0,0"
                    ToolTip.Tip="求值所有 烘焙 节点，把产出的几何加入主绘图场景" />
            <Button Content="删除" Click="OnDeleteSelected" Margin="8,0,0,0" ToolTip.Tip="删除选中节点（Delete）" />
            <Button Content="撤销" Click="OnUndo" ToolTip.Tip="撤销（Ctrl+Z）" />
            <Button Content="重做" Click="OnRedo" ToolTip.Tip="重做（Ctrl+Y）" />
            <Button Content="保存" Click="OnSaveGraph" Margin="8,0,0,0" ToolTip.Tip="保存节点图为 JSON" />
            <Button Content="加载" Click="OnLoadGraph" ToolTip.Tip="从 JSON 加载节点图" />
            <TextBlock x:Name="Hint" Text="拖拽移动 · 点绿输出口再点橙输入口连线 · 双击参数节点改值 · 单击选中后 Delete 删除"
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#8A929C" FontSize="12" />
        </StackPanel>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3E6EA" BorderThickness="1" Margin="8,0,8,8">
            <Canvas x:Name="Canvas" Background="Transparent" ClipToBounds="True" />
        </Border>
    </Grid>
</Window>
