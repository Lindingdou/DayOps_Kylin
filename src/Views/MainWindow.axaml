<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PitMine3D.Kylin.Controls"
        x:Class="PitMine3D.Kylin.Views.MainWindow"
        Width="1240" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#F3F4F6"
        Title="PitMine3D · 麒麟版 (Avalonia + OpenGL 最小实现)">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ============================ 顶部 Ribbon ============================ -->
        <TabControl Grid.Row="0" Classes="ribbon">

            <!-- ===== 开始 ===== -->
            <TabItem Header="开始">
                <Border Background="#F7F8FA" BorderBrush="#DCDFE4" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Height="108">

                            <!-- 文件 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="文件" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="新建" Click="OnRibbonCommand" ToolTip.Tip="新建图形">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{StaticResource icon_new}" />
                                                <TextBlock Text="新建" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="打开" Click="OnRibbonCommand" ToolTip.Tip="打开图形">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{StaticResource icon_open}" />
                                                <TextBlock Text="打开" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="保存" Click="OnRibbonCommand" ToolTip.Tip="保存">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{StaticResource icon_save}" />
                                                <TextBlock Text="保存" />
                                            </StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="另存为" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_save}" /><TextBlock Text="另存为" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="导入" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_import}" /><TextBlock Text="导入" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="选项" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_option}" /><TextBlock Text="选项" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 绘制 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="绘制" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="点" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_point}" /><TextBlock Text="点" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="多段线" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_polyline}" /><TextBlock Text="多段线" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="滑动多段线" Click="OnRibbonCommand" ToolTip.Tip="按住拖动，自动按像素采样插点">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_polyline_slide}" /><TextBlock Text="滑动&#x0a;多段线" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="直线" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_line}" /><TextBlock Text="直线" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" ToolTip.Tip="圆的多种画法">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="圆心、半径" Tag="圆" Click="OnRibbonCommand" />
                                                        <MenuItem Header="两点 (2P)" Tag="圆2P" Click="OnRibbonCommand" />
                                                        <MenuItem Header="三点 (3P)" Tag="圆3P" Click="OnRibbonCommand" />
                                                        <MenuItem Header="切、切、半径 (TTR)" Tag="圆TTR" Click="OnRibbonCommand" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_circle}" /><TextBlock Text="圆 ▾" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" ToolTip.Tip="圆弧的多种画法">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="三点" Tag="圆弧" Click="OnRibbonCommand" />
                                                        <MenuItem Header="起点、圆心、端点" Tag="圆弧SCE" Click="OnRibbonCommand" />
                                                        <MenuItem Header="圆心、起点、端点" Tag="圆弧CSE" Click="OnRibbonCommand" />
                                                        <MenuItem Header="起点、端点、半径" Tag="圆弧SER" Click="OnRibbonCommand" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_arc}" /><TextBlock Text="圆弧 ▾" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="矩形" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_rectangle}" /><TextBlock Text="矩形" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="正多边形" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_polygon}" /><TextBlock Text="正多边形" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="文字" Click="OnRibbonCommand">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_text}" /><TextBlock Text="文字" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 修改 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="修改" />
                                    <WrapPanel Orientation="Vertical" MaxHeight="72">
                                        <Button Classes="ribbon-btn small" Tag="复制" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_copy}" /><TextBlock Text="复制" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="移动" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_move}" /><TextBlock Text="移动" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="延伸" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_extend}" /><TextBlock Text="延伸" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="旋转" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_rotate}" /><TextBlock Text="旋转" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="修剪" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_trim}" /><TextBlock Text="修剪" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="偏移" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_offset}" /><TextBlock Text="偏移" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="打断" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_break}" /><TextBlock Text="打断" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="分解" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_explode}" /><TextBlock Text="分解" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="删除" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_delete}" /><TextBlock Text="删除" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="撤销" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="撤销" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="重做" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="重做" /></StackPanel></Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- 注释 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="注释" />
                                    <WrapPanel Orientation="Vertical" MaxHeight="72">
                                        <Button Classes="ribbon-btn small" Tag="对齐标注" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="对齐标注" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="半径标注" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="半径标注" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="连续标注" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="连续标注" /></StackPanel></Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- 测量 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="测量" />
                                    <WrapPanel Orientation="Vertical" MaxHeight="72">
                                        <Button Classes="ribbon-btn small" Tag="距离" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="距离" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="面积" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="面积" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="角度" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="角度" /></StackPanel></Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- 剪贴板 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="剪贴板" />
                                    <WrapPanel Orientation="Vertical" MaxHeight="72">
                                        <Button Classes="ribbon-btn small" Tag="剪切" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="剪切" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="复制到剪贴板" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="复制" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="粘贴" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="粘贴" /></StackPanel></Button>
                                        <Button Classes="ribbon-btn small" Tag="基点粘贴" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="基点粘贴" /></StackPanel></Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- 图层 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="图层" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="图层特性管理器" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_layer}" /><TextBlock Text="图层特性&#x0a;管理器" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="新建图层" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_layer_add}" /><TextBlock Text="新建&#x0a;图层" /></StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="当前图层" FontSize="11" Foreground="#8A9099" Margin="0,0,0,2" />
                                            <ComboBox SelectedIndex="0" Width="120" MinHeight="26">
                                                <ComboBoxItem>0 · 默认层</ComboBoxItem>
                                                <ComboBoxItem>台阶线</ComboBoxItem>
                                                <ComboBoxItem>坡顶线</ComboBoxItem>
                                            </ComboBox>
                                            <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Button Classes="ribbon-btn small" Tag="全开" Click="OnRibbonCommand" MinWidth="46"><StackPanel Orientation="Horizontal"><TextBlock Text="全开" /></StackPanel></Button>
                                                <Button Classes="ribbon-btn small" Tag="冻结" Click="OnRibbonCommand" MinWidth="46"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_frozen}" /><TextBlock Text="冻结" /></StackPanel></Button>
                                                <Button Classes="ribbon-btn small" Tag="锁定" Click="OnRibbonCommand" MinWidth="46"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_locked}" /><TextBlock Text="锁定" /></StackPanel></Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 视图 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="视图" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="3D" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_3D}" /><TextBlock Text="3D" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="2D" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_2D}" /><TextBlock Text="2D" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="渲染配置" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_render_cfg}" /><TextBlock Text="渲染配置" /></StackPanel></Button>
                                            <Button Classes="ribbon-btn small" Tag="缩放" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_Zoom}" /><TextBlock Text="缩放" /></StackPanel></Button>
                                            <Button Classes="ribbon-btn small" Tag="清空视图" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_clear_marks}" /><TextBlock Text="清空视图" /></StackPanel></Button>
                                            <Button Classes="ribbon-btn small" ToolTip.Tip="标准视图预设">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="俯视" Tag="俯视" Click="OnRibbonCommand" />
                                                        <MenuItem Header="仰视" Tag="仰视" Click="OnRibbonCommand" />
                                                        <MenuItem Header="主视 (前)" Tag="主视" Click="OnRibbonCommand" />
                                                        <MenuItem Header="后视" Tag="后视" Click="OnRibbonCommand" />
                                                        <MenuItem Header="左视" Tag="左视" Click="OnRibbonCommand" />
                                                        <MenuItem Header="右视" Tag="右视" Click="OnRibbonCommand" />
                                                        <MenuItem Header="西南等轴测" Tag="西南等轴测" Click="OnRibbonCommand" />
                                                        <MenuItem Header="东南等轴测" Tag="东南等轴测" Click="OnRibbonCommand" />
                                                        <MenuItem Header="东北等轴测" Tag="东北等轴测" Click="OnRibbonCommand" />
                                                        <MenuItem Header="西北等轴测" Tag="西北等轴测" Click="OnRibbonCommand" />
                                                        <Separator />
                                                        <MenuItem Header="范围缩放" Tag="范围缩放" Click="OnRibbonCommand" />
                                                        <MenuItem Header="上一视图" Tag="上一视图" Click="OnRibbonCommand" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="视图预设 ▾" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 特性 -->
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="特性" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="快速选择" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_quick_select}" /><TextBlock Text="快速&#x0a;选择" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="全部选择" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="全部选择" /></StackPanel></Button>
                                            <Button Classes="ribbon-btn small" Tag="最后" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="最后" /></StackPanel></Button>
                                            <Button Classes="ribbon-btn small" Tag="上次" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><TextBlock Text="上次" /></StackPanel></Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 帮助 -->
                            <Border Classes="ribbon-group" BorderThickness="0">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="帮助" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="帮助文档" Click="OnRibbonCommand">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource icon_help}" /><TextBlock Text="帮助&#x0a;文档" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn small" Tag="注册" Click="OnRibbonCommand"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource icon_register}" /><TextBlock Text="注册" /></StackPanel></Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ===== 模块页（由 build/gen_module_tabs.py 生成，勿手改） ===== -->
            <TabItem Header="地质与工程信息数据库">
                <Border Background="#F7F8FA" BorderBrush="#DCDFE4" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Height="108">
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="钻孔管理" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="导入钻孔数据" Click="OnRibbonCommand" ToolTip.Tip="导入钻孔数据">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource bh_import}" /><TextBlock Text="导入钻孔数据" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="展绘钻孔" Click="OnRibbonCommand" ToolTip.Tip="展绘钻孔">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource bh_plot}" /><TextBlock Text="展绘钻孔" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="虚拟钻孔" Click="OnRibbonCommand" ToolTip.Tip="虚拟钻孔">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource bh_virtual}" /><TextBlock Text="虚拟钻孔" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="开孔坐标管理" Click="OnRibbonCommand" ToolTip.Tip="开孔坐标管理">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource bh_data_manage}" /><TextBlock Text="开孔坐标管理" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="原始钻孔柱状图" Click="OnRibbonCommand" ToolTip.Tip="原始钻孔柱状图">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource bh_histogram}" /><TextBlock Text="原始钻孔柱状图" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="展绘层位数据" Click="OnRibbonCommand" ToolTip.Tip="展绘层位数据">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource bh_layer_plot}" /><TextBlock Text="展绘层位数据" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="煤质管理" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="煤质数据管理" Click="OnRibbonCommand" ToolTip.Tip="煤质数据管理">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource coal_data}" /><TextBlock Text="煤质数据管理" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="空间分布" Click="OnRibbonCommand" ToolTip.Tip="空间分布">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource coal_spatial}" /><TextBlock Text="空间分布" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="数据看板" Click="OnRibbonCommand" ToolTip.Tip="数据看板">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource coal_dashboard}" /><TextBlock Text="数据看板" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="统计分析" Click="OnRibbonCommand" ToolTip.Tip="统计分析">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource coal_stats}" /><TextBlock Text="统计分析" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="钻孔柱状图" Click="OnRibbonCommand" ToolTip.Tip="钻孔柱状图">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource bh_column_3d}" /><TextBlock Text="钻孔柱状图" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="工艺参数管理" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="工艺架构定义" Click="OnRibbonCommand" ToolTip.Tip="工艺架构定义">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource process_arch}" /><TextBlock Text="工艺架构定义" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="平盘工艺地图" Click="OnRibbonCommand" ToolTip.Tip="平盘工艺地图">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource process_map}" /><TextBlock Text="平盘工艺地图" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="参数模板库" Click="OnRibbonCommand" ToolTip.Tip="参数模板库">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource process_tmpl}" /><TextBlock Text="参数模板库" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="现场验收录入" Click="OnRibbonCommand" ToolTip.Tip="现场验收录入">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource process_accept}" /><TextBlock Text="现场验收录入" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="设备管理" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="机群总览" Click="OnRibbonCommand" ToolTip.Tip="机群总览">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource equip_cockpit}" /><TextBlock Text="机群总览" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="设备信息管理" Click="OnRibbonCommand" ToolTip.Tip="设备信息管理">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource equip_info}" /><TextBlock Text="设备信息管理" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="设备智能编组" Click="OnRibbonCommand" ToolTip.Tip="设备智能编组">
