                                            <Button Classes="ribbon-btn small" Tag="影像底图" Click="OnRibbonCommand" ToolTip.Tip="影像底图">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_layout}" /><TextBlock Text="影像底图" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="任务编制" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="生产任务编制" Click="OnRibbonCommand" ToolTip.Tip="生产任务编制">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_create}" /><TextBlock Text="生产任务编制" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="作业区划分" Click="OnRibbonCommand" ToolTip.Tip="作业区划分">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_layout}" /><TextBlock Text="作业区划分" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="周计划编制" Click="OnRibbonCommand" ToolTip.Tip="周计划编制">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_week}" /><TextBlock Text="周计划编制" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="编制配置" Click="OnRibbonCommand" ToolTip.Tip="编制配置">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_config}" /><TextBlock Text="编制配置" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="钻爆计划衔接" Click="OnRibbonCommand" ToolTip.Tip="钻爆计划衔接">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_blast}" /><TextBlock Text="钻爆计划衔接" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="任务下达" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="生产任务书" Click="OnRibbonCommand" ToolTip.Tip="生产任务书">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_order}" /><TextBlock Text="生产任务书" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="任务下达" Click="OnRibbonCommand" ToolTip.Tip="任务下达">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_dispatch}" /><TextBlock Text="任务下达" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="派车单" Click="OnRibbonCommand" ToolTip.Tip="派车单">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_dispatch}" /><TextBlock Text="派车单" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="班组派工" Click="OnRibbonCommand" ToolTip.Tip="班组派工">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_crew}" /><TextBlock Text="班组派工" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="执行调度" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="调度态势看板" Click="OnRibbonCommand" ToolTip.Tip="调度态势看板">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_board}" /><TextBlock Text="调度态势看板" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="实绩录入" Click="OnRibbonCommand" ToolTip.Tip="实绩录入">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_actual}" /><TextBlock Text="实绩录入" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="设备状态·故障报修" Click="OnRibbonCommand" ToolTip.Tip="设备状态·故障报修">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_equipstatus}" /><TextBlock Text="设备状态·故障报修" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="工序进度跟踪" Click="OnRibbonCommand" ToolTip.Tip="工序进度跟踪">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_progress}" /><TextBlock Text="工序进度跟踪" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="评价分析" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="生产报告" Click="OnRibbonCommand" ToolTip.Tip="生产报告">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_report}" /><TextBlock Text="生产报告" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="达成度评价" Click="OnRibbonCommand" ToolTip.Tip="达成度评价">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_attainment}" /><TextBlock Text="达成度评价" /></StackPanel>
                                        </Button>
                                        <WrapPanel Orientation="Vertical" MaxHeight="72">
                                            <Button Classes="ribbon-btn small" Tag="产量统计" Click="OnRibbonCommand" ToolTip.Tip="产量统计">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_stats}" /><TextBlock Text="产量统计" /></StackPanel>
                                            </Button>
                                            <Button Classes="ribbon-btn small" Tag="质量·配煤分析" Click="OnRibbonCommand" ToolTip.Tip="质量·配煤分析">
                                                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource task_coal}" /><TextBlock Text="质量·配煤分析" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Classes="ribbon-group">
                                <DockPanel>
                                    <TextBlock Classes="ribbon-caption" DockPanel.Dock="Bottom" Text="调整·推演" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="ribbon-btn large" Tag="生产任务动态调整" Click="OnRibbonCommand" ToolTip.Tip="生产任务动态调整">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_adjust}" /><TextBlock Text="生产任务动态调整" /></StackPanel>
                                        </Button>
                                        <Button Classes="ribbon-btn large" Tag="班内工艺·工序推演" Click="OnRibbonCommand" ToolTip.Tip="班内工艺·工序推演">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{StaticResource task_simulate}" /><TextBlock Text="班内工艺·工序推演" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ============================ 3D 视口 ============================ -->
        <Grid Grid.Row="1" ColumnDefinitions="220,Auto,*,Auto,260">
        <!-- 左侧对象管理器 -->
        <Border Grid.Column="0" Background="#F7F8FA" BorderBrush="#DCDFE4" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,130,Auto,Auto,*">
                <!-- 文件管理器 -->
                <TextBlock Grid.Row="0" Text="文件管理器" FontWeight="SemiBold" FontSize="13"
                           Margin="10,8,10,4" Foreground="#3A3F46" />
                <Button Grid.Row="1" Content="打开文件夹…" Click="OnOpenFolder"
                        Margin="8,0,8,4" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2" x:Name="FileFolderLabel" Text="未选择文件夹"
                           Margin="10,0,10,4" FontSize="10" Foreground="#8A929C" TextTrimming="CharacterEllipsis" />
                <ListBox Grid.Row="3" x:Name="FileList" Background="Transparent" BorderThickness="0"
                         Margin="4,0" DoubleTapped="OnFileListDoubleTapped" />
                <!-- 图层管理器 -->
                <TextBlock Grid.Row="4" Text="图层" FontWeight="SemiBold" FontSize="13"
                           Margin="10,8,10,4" Foreground="#3A3F46" />
                <ListBox Grid.Row="5" x:Name="LayerList" Background="Transparent" BorderThickness="0" Margin="4,0" />
                <!-- 对象管理器 -->
                <TextBlock Grid.Row="6" Text="对象管理器" FontWeight="SemiBold" FontSize="13"
                           Margin="10,8,10,4" Foreground="#3A3F46" />
                <TextBlock Grid.Row="7" x:Name="ObjectTreeHint" Text="导入图纸后显示实体"
                           Margin="10,0,10,6" FontSize="11" Foreground="#8A929C" />
                <TreeView Grid.Row="8" x:Name="ObjectTree" Background="Transparent" BorderThickness="0" Margin="4,0" />
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="4" Background="#DCDFE4" ResizeDirection="Columns" HorizontalAlignment="Center" />
        <Panel Grid.Column="2" x:Name="ViewportHost" Background="Transparent">
            <Panel.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="范围缩放" Click="OnCtxZoomExtents" />
                    <Separator />
                    <MenuItem Header="2D 平面视图" Click="OnCtx2D" />
                    <MenuItem Header="3D 轨道视图" Click="OnCtx3D" />
                    <Separator />
                    <MenuItem Header="网格 / 轴 开关" Click="OnCtxGrid" />
                    <MenuItem Header="清除高亮" Click="OnCtxClearHighlight" />
                </ContextMenu>
            </Panel.ContextMenu>
            <controls:CadGlViewport x:Name="Viewport" />
            <!-- 左上叠加信息 -->
            <Border Background="#B0000000" CornerRadius="6" Padding="10,7"
                    Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="3D 视口 · OpenGL" Foreground="#EAF2FF" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="左键拖拽 = 轨道旋转 · 滚轮 = 缩放" Foreground="#B9C6D6" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock x:Name="GlInfo" Text="渲染后端: 初始化中…" Foreground="#8FE3A0" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <!-- 右下角坐标系铭牌 -->
            <Border Background="#80102040" CornerRadius="4" Padding="8,5"
                    Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="Z 上 · CGCS2000 约定" Foreground="#C9D6E6" FontSize="11" />
            </Border>
        </Panel>
        <GridSplitter Grid.Column="3" Width="4" Background="#DCDFE4" ResizeDirection="Columns" HorizontalAlignment="Center" />
        <!-- 右侧特性面板 -->
        <Border Grid.Column="4" Background="#F7F8FA" BorderBrush="#DCDFE4" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="特性" FontWeight="SemiBold" FontSize="13"
                           Margin="10,8,10,4" Foreground="#3A3F46" />
                <TextBlock Grid.Row="1" x:Name="PropertyHint" Text="选中单个实体查看特性"
                           Margin="10,0,10,6" FontSize="11" Foreground="#8A929C" />
                <ScrollViewer Grid.Row="2" Margin="4,0,4,8">
                    <StackPanel x:Name="PropertyPanel" />
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>

        <!-- ============================ 命令行 ============================ -->
        <Border Grid.Row="2" Background="#1E1F22" Padding="8,4">
            <DockPanel>
                <!-- 命令输入行 -->
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="命令:" Foreground="#9DA3AD" VerticalAlignment="Center" Margin="2,0,8,0" FontFamily="Consolas,monospace" />
                    <TextBox Grid.Column="1" x:Name="CommandInput"
                             Background="Transparent" BorderThickness="0" Foreground="#E6E6E6"
                             FontFamily="Consolas,monospace" Watermark="命令别名/中文命令后回车（LINE / 距离 / 俯视 …），↑↓ 回溯历史，Tab 补全"
                             KeyDown="OnCommandKeyDown" TextChanged="OnCommandInputChanged" />
                </Grid>
                <!-- 命令自动补全候选 -->
                <TextBlock x:Name="CmdSuggest" DockPanel.Dock="Bottom" Foreground="#C7A96B" FontSize="11"
                           FontFamily="Consolas,monospace" Margin="40,0,0,2" Text="" IsVisible="False" />
                <!-- 命令历史/输出回显 -->
                <ScrollViewer x:Name="CmdLogScroll" DockPanel.Dock="Top" MaxHeight="60" Margin="0,0,0,3"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CmdLog" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================ 状态栏 ============================ -->
        <Border Grid.Row="3" Background="#0A5AD4" Height="26">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" x:Name="CoordText" Text="X 0.000  Y 0.000  Z 0.000"
                           Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="12" FontFamily="Consolas,monospace" />
                <ToggleButton Grid.Column="1" x:Name="SnapToggle" Content="对象捕捉" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,0" FontSize="12" />
                <ToggleButton Grid.Column="2" x:Name="OrthoToggle" Content="正交" IsCheckedChanged="OnOrthoToggle" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,0" FontSize="12" />
                <ToggleButton Grid.Column="3" x:Name="GridSnapToggle" Content="栅格捕捉" IsCheckedChanged="OnGridSnapToggle" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,0" FontSize="12" />
                <TextBlock Grid.Column="4" x:Name="StatusMsg" Text="就绪" Foreground="#DCE8FF" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
                <TextBlock Grid.Column="5" Text="Avalonia 11 · OpenGL · 麒麟 SP10 就绪"
                           Foreground="#DCE8FF" VerticalAlignment="Center" Margin="10,0" FontSize="12" />
            </Grid>
        </Border>

    </Grid>
</Window>
