<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PitMine3D.Kylin.Views.Modeling.CoalQualityLinkWindow" x:CompileBindings="False"
        Classes="geodb" Title="煤质属性联动" Width="540" Height="580" WindowStartupLocation="CenterOwner">
  <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
    <TextBlock Text="把钻孔煤质指标按煤层估到块体煤块 → 写成属性列（着色/筛选/报表复用）" TextWrapping="Wrap" Classes="muted" Margin="0,0,0,6"/>
    <TextBlock x:Name="modelInfo" Grid.Row="1" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="煤层属性列" VerticalAlignment="Center" Width="80"/>
      <ComboBox x:Name="attrCombo" Width="220" SelectionChanged="OnAttrChanged"/>
      <TextBlock Text="（不同值=不同煤层）" VerticalAlignment="Center" Margin="8,0,0,0" Classes="muted"/>
    </StackPanel>
    <Border Grid.Row="3" Classes="panel" Margin="0,2,0,8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Theme.Window.Background}" ColumnDefinitions="110,80,*">
          <TextBlock Text="属性值" Margin="8,4" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="块数" Margin="4,4" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="→ 映射到煤层" Margin="4,4" FontWeight="SemiBold"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="mapList" Margin="4">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,2" ColumnDefinitions="110,80,*">
                  <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Count}" VerticalAlignment="Center" Classes="muted"/>
                  <ComboBox Grid.Column="2" ItemsSource="{Binding SeamOptions}" SelectedItem="{Binding Seam, Mode=TwoWay}" Margin="0,0,6,0" HorizontalAlignment="Stretch"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="指标" VerticalAlignment="Center" Width="80"/>
      <CheckBox x:Name="cbAd" Content="Ad 灰分" IsChecked="True" Margin="0,0,10,0"/>
      <CheckBox x:Name="cbSt" Content="St 全硫" Margin="0,0,10,0"/>
      <CheckBox x:Name="cbQnet" Content="Qnet 发热" Margin="0,0,10,0"/>
      <CheckBox x:Name="cbVdaf" Content="Vdaf" Margin="0,0,10,0"/>
      <CheckBox x:Name="cbG" Content="G 粘结" Margin="0,0,10,0"/>
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="样品" VerticalAlignment="Center" Width="80"/>
      <RadioButton x:Name="rbRaw" GroupName="Sample" Content="原煤" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
      <RadioButton x:Name="rbClean" GroupName="Sample" Content="浮煤" Margin="0,0,20,0" VerticalAlignment="Center"/>
      <TextBlock Text="方法" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="methodCombo" Width="150"/>
    </StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="0,0,4,0" Classes="muted"/>
      <Button Content="预览" Click="OnPreview" Padding="14,5"/>
      <Button Content="运行" Click="OnRun" Padding="18,5" FontWeight="Bold" Classes="primary"/>
      <Button Content="关闭" Click="OnClose" Padding="14,5"/>
    </StackPanel>
  </Grid>
</Window>
