<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ch="using:PitMine3D.Kylin.Controls.Charts"
        x:Class="PitMine3D.Kylin.Views.Modeling.CurrentStateRealisticWindow" x:CompileBindings="False"
        Classes="geodb" Title="现状写实（拾取见煤点）" Width="900" Height="620" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Classes="toolbar" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="批次:" VerticalAlignment="Center" Margin="2,0,4,0"/>
                <ComboBox x:Name="batchCombo" Width="220" SelectionChanged="OnBatchChanged"
                          ToolTip.Tip="当前现状写实批次(拾取的见煤点归入此批次)；系统唯一时间标签"/>
                <Button Content="新建批次" Click="OnNewBatch" Padding="8,2"/>
                <Button Content="数据管理" Click="OnManageData" Padding="8,2" ToolTip.Tip="按批次(时间标签)删除 / 改名"/>
                <Border Width="1" Background="#D0D4DA" Margin="2,2"/>
                <Button Content="煤层结构…" Click="OnEditStructure" Padding="8,2" ToolTip.Tip="预置煤层(拾取弹窗从这里选煤层)"/>
                <Border Width="1" Background="#D0D4DA" Margin="2,2"/>
                <Button x:Name="pickButton" Content="开始拾取" Click="OnStartPick" Padding="8,2" Classes="primary"
                        ToolTip.Tip="进入拾取:在视口点击三角网/点上的见煤点，逐点弹窗定煤层+顶/底；Esc 结束"/>
                <Button Content="停止拾取" Click="OnStopPick" Padding="8,2"/>
                <Button Content="采集选中点" Click="OnCollectSelected" Padding="8,2"
                        ToolTip.Tip="把视口里当前选中的点(带高程)整批记为见煤点，弹一次窗定煤层+顶/底"/>
                <Border Width="1" Background="#D0D4DA" Margin="2,2"/>
                <Button Content="删除" Click="OnDelete" Padding="8,2" Classes="danger"/>
                <Button Content="保存" Click="OnSave" Padding="8,2" Classes="primary"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Classes="toolbar" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox x:Name="markCheck" Content="图上标注" IsChecked="True" VerticalAlignment="Center" Margin="2,0,4,0"
                          IsCheckedChanged="OnMarkToggled"
                          ToolTip.Tip="拾取到的点在视口里画出来：落点十字 + 竖杆 + 引线牵出「Z=高程」和「煤层·层位」文字&#x0a;顶板=青绿 · 底板=橙黄；标注放在图层「现状见煤点标注」，只画当前批次"/>
                <TextBlock Text="字高(m)" VerticalAlignment="Center" Margin="2,0,3,0" Opacity="0.75"/>
                <TextBox x:Name="markSizeBox" Text="10" Width="48" VerticalAlignment="Center"
                         ToolTip.Tip="标注基准尺寸(米)：文字字高=该值，十字臂长=0.75倍，竖杆=1.6倍。按模型大小调，改完点「重绘标注」"/>
                <Button Content="重绘标注" Click="OnRedrawMarks" Padding="8,2" ToolTip.Tip="按当前字高重画本批次全部见煤点的标注"/>
                <Button Content="清除标注" Click="OnClearMarks" Padding="8,2" ToolTip.Tip="删除图层「现状见煤点标注」上的全部标注（不影响已记录的数据）"/>
                <Border Width="1" Background="#D0D4DA" Margin="2,2"/>
                <Button Content="下载模板…" Click="OnDownloadTemplate" Padding="8,2" ToolTip.Tip="现状点 CSV 模板：经距X / 纬距Y / 高程Z / 备注 / 煤层编号 / 层位"/>
                <Button Content="导入 CSV…" Click="OnImportCsv" Padding="8,2" ToolTip.Tip="导入现状点(CSV)到当前批次；点「保存」入库"/>
                <Button Content="导出 CSV" Click="OnExportCsv" Padding="8,2"/>
                <Border Width="1" Background="#D0D4DA" Margin="2,2"/>
                <Button Content="建现状面" Click="OnBuildSurface" Padding="8,2"
                        ToolTip.Tip="由当前批次全部现状点 Delaunay 三角化建「现状面」三角网入场景（需 ≥3 点）"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="statusbar" Margin="0,8,0,0">
            <TextBlock x:Name="statusText" Text="就绪" TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="pointGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="经距X" Binding="{Binding XDisp}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="纬距Y" Binding="{Binding YDisp}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="高程Z" Binding="{Binding ZDisp}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="煤层" Binding="{Binding SeamName}" IsReadOnly="True" Width="Auto" MinWidth="90"/>
                <DataGridTextColumn Header="层位" Binding="{Binding Horizon}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=TwoWay}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
