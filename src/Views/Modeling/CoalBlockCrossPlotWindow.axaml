<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ch="using:PitMine3D.Kylin.Controls.Charts"
        x:Class="PitMine3D.Kylin.Views.Modeling.CoalBlockCrossPlotWindow" x:CompileBindings="False"
        Classes="geodb" Title="煤质 × 块体 交会分析" Width="820" Height="640" WindowStartupLocation="CenterOwner">
  <Grid Margin="14" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="在每个钻孔煤质点的位置采样块体属性 → 煤质指标 × 块体属性 交会散点（不改块体）" TextWrapping="Wrap" Classes="muted"/>
    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
      <TextBlock Text="煤质指标" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <ComboBox x:Name="indicatorCombo" Width="140" Margin="0,0,6,0" SelectedIndex="0">
        <ComboBoxItem Content="Ad 灰分" Tag="ad"/>
        <ComboBoxItem Content="St 全硫" Tag="std"/>
        <ComboBoxItem Content="Qnet 发热量" Tag="qnet"/>
        <ComboBoxItem Content="Vdaf 挥发分" Tag="vdaf"/>
        <ComboBoxItem Content="G 粘结指数" Tag="caking"/>
      </ComboBox>
      <RadioButton x:Name="rbRaw" GroupName="S" Content="原煤" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <RadioButton x:Name="rbClean" GroupName="S" Content="浮煤" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBlock Text="块体属性" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <ComboBox x:Name="blockAttrCombo" Width="180" Margin="0,0,12,0"/>
      <Button Content="运行交会" Click="OnRun" Padding="16,4" FontWeight="Bold" Classes="primary"/>
    </WrapPanel>
    <Border Grid.Row="2" Classes="panel">
      <ch:ChartView x:Name="scatterChart" Margin="6"/>
    </Border>
    <TextBlock x:Name="statsText" Grid.Row="3" Margin="0,8,0,0" FontSize="13"/>
  </Grid>
</Window>
