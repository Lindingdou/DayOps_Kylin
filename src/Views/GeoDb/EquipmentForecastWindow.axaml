<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ch="using:PitMine3D.Kylin.Controls.Charts"
        x:Class="PitMine3D.Kylin.Views.GeoDb.EquipmentForecastWindow" x:CompileBindings="False"
        Classes="geodb" Title="设备效能预测 — What-if 提升路径模拟器" Width="1480" Height="940" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="hdr hdr-purple" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎚" FontSize="22" Margin="0,0,12,0" Foreground="White"/>
                    <StackPanel>
                        <TextBlock Text="设备效能预测 — What-if 模拟器" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="调整 4 个杠杆 · 实时看产能提升潜力 · 排定优化优先级" Foreground="#FFD1C4E9" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFD1C4E9" FontSize="11" Text="模型:基线产能 × (1 + Σ 杠杆贡献),贡献度有上限以避免理论值膨胀"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8" ColumnDefinitions="220,8,340,8,*">
            <!-- 左:设备列表 -->
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="panel-hdr">
                        <TextBlock Text="选择设备" Classes="panel-title"/>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="equipmentList" Margin="4" BorderThickness="0" SelectionChanged="OnEquipmentSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding EquipmentId}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding Model}" Classes="muted" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent"/>

            <!-- 中:控制面板(4 个杠杆滑块 + 基线信息) -->
            <Border Grid.Column="2" Classes="panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Background="#FFE3F2FD" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="基线状态" FontWeight="Bold" FontSize="12" Foreground="#FF0D47A1"/>
                                <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前月产能" FontSize="11" Classes="muted"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="baselineOutput" Text="—" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="可用率" FontSize="11" Classes="muted" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="baselineAvail" Text="—" FontWeight="Bold" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="实动率" FontSize="11" Classes="muted" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="baselineRun" Text="—" FontWeight="Bold" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="故障小时" FontSize="11" Classes="muted" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="baselineFault" Text="—" FontWeight="Bold" FontSize="13" Foreground="#FFC62828" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🎚 调整下列杠杆,实时模拟提升潜力" FontWeight="Bold" FontSize="13" Foreground="#FF0D47A1" Margin="0,0,0,12"/>

                        <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#FFFFF8E1">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="① 故障小时降低" FontWeight="Bold" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="lever1Value" Text="0" FontWeight="Bold" FontSize="14" Foreground="#FFE65100"/>
                                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2" Foreground="#FFE65100"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="lever1Slider" Minimum="0" Maximum="80" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnLeverChanged"/>
                                <TextBlock Text="减少故障停机 → 解锁作业时间 → 产能提升" FontSize="10" Classes="muted"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#FFE3F2FD">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="② 出动率提升" FontWeight="Bold" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="lever2Value" Text="0" FontWeight="Bold" FontSize="14" Foreground="#FF1976D2"/>
                                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2" Foreground="#FF1976D2"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="lever2Slider" Minimum="0" Maximum="30" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnLeverChanged"/>
                                <TextBlock Text="减少待命/无效出动 → 实动比例 ↑" FontSize="10" Classes="muted"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#FFE8F5E9">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="③ 装载效率优化" FontWeight="Bold" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="lever3Value" Text="0" FontWeight="Bold" FontSize="14" Foreground="#FF388E3C"/>
                                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2" Foreground="#FF388E3C"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="lever3Slider" Minimum="0" Maximum="20" Value="0" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnLeverChanged"/>
                                <TextBlock Text="单斗装载量↑(操作技能/铲斗匹配) → 单循环产量↑" FontSize="10" Classes="muted"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#FFFCE4EC">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="④ 运距/工序衔接优化" FontWeight="Bold" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="lever4Value" Text="0" FontWeight="Bold" FontSize="14" Foreground="#FFC2185B"/>
                                        <TextBlock Text="%" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2" Foreground="#FFC2185B"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="lever4Slider" Minimum="0" Maximum="25" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OnLeverChanged"/>
                                <TextBlock Text="卡车循环时间↓/排土点优化 → 等待装车↓" FontSize="10" Classes="muted"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
                            <Button Content="📋 预设:激进" Click="OnPresetAggressive" Padding="10,4"/>
                            <Button Content="📋 预设:保守" Click="OnPresetConservative" Padding="10,4"/>
                            <Button Content="🔄 重置" Click="OnReset" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" Background="Transparent"/>

            <!-- 右:模拟结果展示 -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*,*,Auto">
                <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,8">
                    <Border CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FF424242" Offset="0"/><GradientStop Color="#FF757575" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="基线(当前)" Foreground="#FFE0E0E0" FontSize="11"/>
                            <TextBlock x:Name="resultBaseline" Text="—" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="万 m³/月" Foreground="#FFE0E0E0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FF388E3C" Offset="0"/><GradientStop Color="#FF66BB6A" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="模拟后产能" Foreground="#FFE8F5E9" FontSize="11"/>
                            <TextBlock x:Name="resultSimulated" Text="—" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="万 m³/月" Foreground="#FFE8F5E9" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FFF57C00" Offset="0"/><GradientStop Color="#FFFFB74D" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="净提升" Foreground="#FFFFF3E0" FontSize="11"/>
                            <TextBlock x:Name="resultGain" Text="—" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="resultGainPct" Text="—%" Foreground="#FFFFF3E0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="14,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FF1565C0" Offset="0"/><GradientStop Color="#FFAB47BC" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="行业标杆对照" Foreground="#FFE3F2FD" FontSize="11"/>
                            <TextBlock x:Name="resultBenchmark" Text="—" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="resultBenchmarkHint" Text="" Foreground="#FFE3F2FD" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Classes="panel">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="panel-hdr">
                            <StackPanel>
                                <TextBlock Text="产能提升阶梯图(逐项叠加)" Classes="panel-title" FontSize="12"/>
                                <TextBlock Text="左到右:基线 → 加 ① → 加 ② → 加 ③ → 加 ④ → 综合后" Classes="muted" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <ch:ChartView Grid.Row="1" x:Name="stackChart" Margin="6" Legend="Hidden" YTitle="月产能(万 m³)"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="panel" Margin="0,8,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="panel-hdr">
                            <StackPanel>
                                <TextBlock Text="杠杆贡献排序(找性价比最高的优先做)" Classes="panel-title" FontSize="12"/>
                                <TextBlock Text="贡献度 = 该杠杆对净提升的占比" Classes="muted" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <ch:ChartView Grid.Row="1" x:Name="contributionChart" Margin="6" Legend="Hidden" YTitle="产能贡献 (%)" YFormat="0'%'"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Classes="panel" Margin="0,8,0,0">
                    <Grid RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Padding="10,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#FFE3F2FD" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="1"/></LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="📋 综合结论" FontWeight="Bold" FontSize="12" Foreground="#FF0D47A1"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="conclusionText" Margin="12,8,12,10" TextWrapping="Wrap" LineHeight="22" FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="statusbar">
            <TextBlock x:Name="statusText" Text="就绪"/>
        </Border>
    </Grid>
</Window>
